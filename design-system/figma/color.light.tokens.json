    },
    "on-amber": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Texto sobre rellenos ámbar (botón principal, badge de plan). En claro, blanco sobre ámbar da 2.6:1: valor real del sitio, revisar si se prioriza el tema claro."
    },
    "btn-fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
