    },
    "focus": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1137,
          0.1137,
          0.1216
        ],
        "alpha": 1,
        "hex": "#1d1d1f"
      },
      "$description": "Anillo de foco de teclado (2.5px, separado 3px) sobre cualquier superficie."
    },
    "green": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2039,
          0.7804,
          0.349
