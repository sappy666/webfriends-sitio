---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  noindex
  title="Mensaje enviado — Webfriends"
  description="Recibimos tu solicitud y te responderemos pronto."
>
  <section class="hero grid-bg" style="padding-block:clamp(70px,10vw,130px)">
    <div class="wrap" data-hero-seq>
      <p class="eyebrow">Solicitud enviada</p>
      <h1 style="font-size:var(--s-3);max-width:18ch;margin:0 auto 20px">¡Gracias! Recibimos tu mensaje</h1>
      <h2 class="sr-only">Qué sigue</h2>
      <p class="lede" style="margin:0 auto;text-align:center;max-width:48ch">Te responderemos al correo que indicaste en menos de 24 horas hábiles. Si es urgente, escríbenos por WhatsApp.</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/">Volver al inicio
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
        <a class="btn btn-soft" href="/blog/">Ver el blog</a>
      </div>
    </div>
  </section>

</BaseLayout>
