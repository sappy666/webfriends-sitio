---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada — Webfriends"
  description="La página que buscas no existe."
>
  <section class="hero grid-bg" style="padding-block:clamp(70px,10vw,130px)">
    <div class="wrap" data-hero-seq>
      <p class="eyebrow">Error 404</p>
      <h1 style="font-size:var(--s-3);max-width:18ch;margin:0 auto 20px">Esta página no existe</h1>
      <h2 class="sr-only">Opciones disponibles</h2>
      <p class="lede" style="margin:0 auto;text-align:center;max-width:48ch">Puede que el enlace esté roto o que la página haya cambiado de dirección.</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/">Volver al inicio
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
        <a class="btn btn-soft" href="/contacto">Contactarnos</a>
      </div>
    </div>
  </section>

</BaseLayout>
