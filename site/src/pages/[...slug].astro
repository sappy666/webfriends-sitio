---
export const prerender = true;
import { getCollection } from 'astro:content';
import SeoPage from '../components/pages/SeoPage.astro';
import GoogleAdsPage from '../components/pages/GoogleAdsPage.astro';
import SitiosWebPage from '../components/pages/SitiosWebPage.astro';
import UxUiPage from '../components/pages/UxUiPage.astro';
import SaludPage from '../components/pages/SaludPage.astro';
import CasosPage from '../components/pages/CasosPage.astro';
import NosotrosPage from '../components/pages/NosotrosPage.astro';
import ContactoPage from '../components/pages/ContactoPage.astro';
import TerminosPage from '../components/pages/TerminosPage.astro';
import ServiciosPage from '../components/pages/ServiciosPage.astro';
import PreciosPage from '../components/pages/PreciosPage.astro';
import TutorialesPage from '../components/pages/TutorialesPage.astro';
import TiendaPage from '../components/pages/TiendaPage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((p) => !!p.data.urlSlug)
    .map((p) => ({ params: { slug: p.data.urlSlug } }));
}

const allPages = await getCollection('pages');
const pageId = allPages.find((p) => p.data.urlSlug === Astro.params.slug)?.id;
---
{pageId === 'page-seo' && <SeoPage />}
{pageId === 'page-google-ads' && <GoogleAdsPage />}
{pageId === 'page-sitios-web' && <SitiosWebPage />}
{pageId === 'page-ux-ui' && <UxUiPage />}
{pageId === 'page-salud' && <SaludPage />}
{pageId === 'page-casos' && <CasosPage />}
{pageId === 'page-nosotros' && <NosotrosPage />}
{pageId === 'page-contacto' && <ContactoPage />}
{pageId === 'page-terminos' && <TerminosPage />}
{pageId === 'page-servicios' && <ServiciosPage />}
{pageId === 'page-precios' && <PreciosPage />}
{pageId === 'page-tutoriales' && <TutorialesPage />}
{pageId === 'page-tienda' && <TiendaPage />}
