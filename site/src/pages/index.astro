---
import PlanCard from '../components/PlanCard.astro';
export const prerender = true;
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingFx from '../components/PricingFx.astro';
import ArcScroll from '../components/ArcScroll.astro';

const featuredCasos = await getCollection('casos', ({ data }) => data.featured);
const page = (await getEntry('pages', 'page-home'))!.data;
const sec = (id: string) => page.sections.find((s) => s.id === id)!;
const webPlans = (await getEntry('planSets', 'desarrollo-web'))!.data.plans;
const adsPlans = (await getEntry('planSets', 'google-ads'))!.data.plans;
const proceso = (await getEntry('procesoSeisEtapas', 'proceso-seis-etapas'))!.data.steps;
const pages = await getCollection('pages');
const slug = (id: string) => `/${pages.find((p) => p.id === id)!.data.urlSlug}`;
const serviceMeta = [
  { num: '01 — WEB', pageId: 'page-sitios-web', linkLabel: 'Ver planes web' },
  { num: '02 — SEO', pageId: 'page-seo', linkLabel: 'Ver SEO' },
  { num: '03 — GOOGLE ADS', pageId: 'page-google-ads', linkLabel: 'Ver Google Ads' },
  { num: '04 — HEALTH', pageId: 'page-salud', linkLabel: 'Ver soluciones para salud' },
  { num: '05 — UX/UI', pageId: 'page-ux-ui', linkLabel: 'Ver diseño UX/UI' },
];
// Ilustración 3D de cada servicio (webp con fondo transparente), mismo orden que serviceMeta.
const serviceArt = ['web-1', 'seo-1', 'ads', 'medical-1', 'uxui-1'];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={page.ogImage?.image}
  ogImageAlt={page.ogImage?.alt}
>


  <!-- ═══════ HERO ═══════ -->
  <section class="hero hero-split grid-bg" id="inicio" style="text-align:left">
    <span class="hero-corner-label" aria-hidden="true">Agencia digital · Chile</span>
    <div class="wrap hero-split-grid" data-hero-seq>
      <div>
        <p class="eyebrow">{page.heroEyebrow}</p>
        <h1 style="margin-inline:0">{page.heroH1}</h1>
        <p class="lede" style="margin:18px 0 0;text-align:left">{page.heroLede}</p>
        <div class="hero-actions" style="justify-content:flex-start">
          <a class="btn btn-accent" href="#contacto">
            Quiero crecer mi negocio
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </a>
          <a class="btn btn-soft" href="#servicios">Conocer servicios</a>
        </div>
        <ul class="hero-checks">
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><use href="#i-check"></use></svg> Estrategia personalizada</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><use href="#i-check"></use></svg> Acompañamiento real</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><use href="#i-check"></use></svg> Resultados medibles</li>
        </ul>
      </div>

      <div class="hero-visual" data-reveal="scale">
        <div class="dash">
          <div class="dash-bar"><span></span><span></span><span></span><p>Panel Webfriends</p></div>
          <div class="dash-body">
            <p class="dash-title">Tu negocio puede más</p>
            <svg class="dash-chart" viewBox="0 0 260 70" fill="none" aria-hidden="true">
              <path d="M2 56 C 40 56, 55 22, 88 32 S 148 12, 180 20 S 232 6, 258 4" stroke="var(--amber)" stroke-width="3" stroke-linecap="round"/>
            </svg>
            <div class="dash-stats">
              <div><b>$500M+</b><span>gestionados en campañas</span></div>
              <div><b>500+</b><span>clientes atendidos</span></div>
              <div><b>7 años</b><span>Google Partner</span></div>
            </div>
          </div>
        </div>
        <div class="float-chip chip-1">
          <span class="chip-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#i-search"></use></svg></span>
          <div><b>SEO</b><i>Más visibilidad</i></div>
        </div>
        <div class="float-chip chip-2">
          <span class="chip-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#i-trending"></use></svg></span>
          <div><b>Google Ads</b><i>Más clientes</i></div>
        </div>
        <div class="float-chip chip-3">
          <span class="chip-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#i-monitor"></use></svg></span>
          <div><b>Desarrollo Web</b><i>Más oportunidades</i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ MARCAS QUE CONFÍAN ═══════ -->
  <section class="proof-strip" aria-labelledby="proof-h">
    <div class="wrap">
      <h2 id="proof-h" class="proof-kicker" data-reveal>Marcas que confían en nosotros</h2>
      <div class="proof-marquee" data-reveal>
        {[false, true].map((copy) => (
          <div class="proof-track" aria-hidden={copy ? "true" : undefined}>
            {[
              { name: "CEAPSI", href: "https://ceapsi.cl/" },
              { name: "Novamente", href: "https://www.novamente.cl/" },
              { name: "Liv Salud", href: "https://livsalud.cl/" },
              { name: "Punto Cero", href: "https://puntoceropatagonia.com/" },
              { name: "Clinit", href: "https://clinit.cl/" },
              { name: "Meni", href: "https://meni.cl/" },
              { name: "Familia Salud", href: "https://familiasalud.cl/" },
              { name: "Serviteclomas", href: "https://serviteclomas.cl/" },
              { name: "Fortalece", href: "https://fortalececonsultora.cl/" },
            ].map((b) => <a class="proof-item" href={b.href} target="_blank" rel="noopener" tabindex={copy ? -1 : undefined}>{b.name}</a>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ MÉTRICAS ═══════
       Los valores finales están escritos en el HTML: nunca pueden verse en 0. -->
  <section class="figures figures-grid" aria-labelledby="m-h">
    <div class="wrap">
      <h2 id="m-h" class="sr-only">Cifras de Webfriends</h2>

      <ol class="fig-list" id="figList">
        <li class="fig" style="--i:0">
          <span class="fig-n"><span data-count="500" data-prefix="$">$500</span><em>M+</em></span>
          <span class="fig-l">en gestión publicitaria<i>Acumulado 2019–2026</i></span>
        </li>
        <li class="fig" style="--i:1">
          <span class="fig-n"><span data-count="150">150</span><em>+</em></span>
          <span class="fig-l">plataformas desarrolladas<i>Sitios, tiendas y sistemas</i></span>
        </li>
        <li class="fig" style="--i:2">
          <span class="fig-n"><span data-count="500">500</span><em>+</em></span>
          <span class="fig-l">clientes atendidos<i>En Chile y Latinoamérica</i></span>
        </li>
        <li class="fig" style="--i:3">
          <span class="fig-n"><span data-count="7">7</span><em> años</em></span>
          <span class="fig-l">como Google Partner<i>Credencial oficial verificable</i></span>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══════ SERVICIOS ═══════ -->
  <section id="servicios" aria-labelledby="s-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('s-h').eyebrow}</p>
      <h2 id="s-h" class="h-sec" data-reveal>{sec('s-h').heading}</h2>
      <p class="lede" data-reveal style="margin-top:18px">Puedes contratarlas por separado o como estrategia integral. Siempre partimos por medir dónde estás hoy.</p>

      <div class="bento-grid compact" data-reveal-group>
        {[2, 0, 1, 3, 4].map((i, pos) => ({ card: sec('s-h').cards[i], i, pos })).map(({ card, i, pos }) => (
          <article class="bento" data-reveal="scale">
            <div class="bento-txt">
              <p class="bento-num">{serviceMeta[i].num}</p>
              <p class="bento-hook">{card.title}</p>
              <p class="bento-desc">{card.description}</p>
              <a class={pos === 0 ? 'bento-link btn' : 'bento-link'} href={slug(serviceMeta[i].pageId)}>{serviceMeta[i].linkLabel} <i aria-hidden="true">→</i></a>
            </div>
            <img class="bento-ill" src={`/assets/img/${serviceArt[i]}.webp`} alt="" width="1312" height="1199" loading="lazy" decoding="async" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ CASOS DE ÉXITO ═══════ -->
  <section id="casos" aria-labelledby="cx-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow" data-reveal>{sec('cx-h').eyebrow}</p>
          <h2 id="cx-h" class="h-sec" data-reveal>{sec('cx-h').heading}</h2>
        </div>
        <a class="card-link" href="/casos" data-reveal>Ver todos los casos <i aria-hidden="true">›</i></a>
      </div>

      <div class="case-grid" data-reveal-group>
        {featuredCasos.map((caso) => (
          <article class="case-card" data-reveal="scale">
            <p class="case-tag">{caso.data.tag}</p>
            <h3>{caso.data.client}</h3>
            <p class="case-sector">{caso.data.sector}</p>
            <p class="case-result">{caso.data.result}</p>
            <a class="bento-link" href="/casos">Ver el caso <i aria-hidden="true">›</i></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ PLANES ═══════
       Control segmentado en vez de dos tablas apiladas: reduce el scroll
       y hace explícito que son dos servicios distintos.                  -->
  <section id="planes" class="grad-cool" aria-labelledby="p-h">
    <div class="wrap" style="text-align:center">
      <p class="eyebrow" data-reveal>{sec('p-h').eyebrow}</p>
      <h2 id="p-h" class="h-sec" data-reveal style="margin-inline:auto">{sec('p-h').heading}</h2>
      <p class="lede" data-reveal style="margin:18px auto 0;text-align:center">Precios publicados, sin letra chica. Todos incluyen ejecutivo asignado y reporte mensual.</p>

      <div class="segmented" data-reveal role="tablist" aria-label="Tipo de plan">
        <span class="seg-thumb" id="thumb" aria-hidden="true"></span>
        <button role="tab" id="tab-web" aria-controls="panel-web" aria-selected="true">Desarrollo web</button>
        <button role="tab" id="tab-ads" aria-controls="panel-ads" aria-selected="false">Google Ads</button>
      </div>
    </div>

    <div class="wrap" style="text-align:left">
      <div class="tabpanel" id="panel-web" role="tabpanel" aria-labelledby="tab-web">
        <div class="pricing" data-reveal-group>
          {webPlans.map((plan) => (
            <PlanCard plan={plan} />
          ))}
        </div>
      </div>

      <div class="tabpanel" id="panel-ads" role="tabpanel" aria-labelledby="tab-ads" hidden>
        <div class="pricing" data-reveal-group>
          {adsPlans.map((plan) => (
            <PlanCard plan={plan} />
          ))}
        </div>
      </div>

      <p data-reveal style="text-align:center;margin-top:36px;color:var(--label-2)">
        ¿Necesitas algo distinto? <a href="/contacto" style="color:var(--amber);font-weight:700;text-decoration:none">Cuéntanos tu caso</a>
      </p>
    </div>
  </section>

  <!-- ═══════ PROCESO ═══════ -->
  <section id="proceso" aria-labelledby="pr-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('pr-h').eyebrow}</p>
      <h2 id="pr-h" class="h-sec" data-reveal>{sec('pr-h').heading}</h2>
      <p class="lede" data-reveal style="margin-top:18px">Un proceso claro y colaborativo. Sabes qué recibes y cuándo, en cada una de las etapas.</p>
    </div>

    <!-- Recorrido en arco: las etapas avanzan sobre una curva a medida
         que se hace scroll. Sin JS o con movimiento reducido, se muestra
         como una lista ordenada normal y completamente legible. -->
    <div class="arc-stage" id="arcStage">
      <div class="arc-sticky">
        <div class="wrap arc-inner">

          <svg class="arc-curve" viewBox="0 0 200 800" fill="none" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 196 -60 C 40 140, 40 660, 196 860" stroke="var(--line-2)" stroke-width="1.5"/>
          </svg>

          <p class="arc-progress" aria-hidden="true">
            <span id="arcCurrent">01</span><span class="arc-sep">/</span><span>06</span>
          </p>

          <ol class="arc-list" id="arcList" data-reveal-group style="--rv-step:160ms;--rv-duration:1600ms;--rv-distance:10px">
            {proceso.map((step, i) => (
              <li class="arc-step" data-reveal="fade" style={`--i:${i}`}>
                <span class="arc-dot" aria-hidden="true"></span><span class="arc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="arc-body">
                  <span class="arc-title">{step.title}</span>
                  <span class="arc-desc">{step.description}</span>
                </span>
              </li>
            ))}
          </ol>

        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ CONTACTO ═══════ -->
  <section id="contacto" class="grid-bg" aria-labelledby="ct-h">
    <div class="wrap">
      <div class="contact-card" data-reveal>
        <div>
          <p class="eyebrow">{sec('ct-h').eyebrow}</p>
          <h2 id="ct-h" style="font-size:var(--s-3)">{sec('ct-h').heading}</h2>
          <p class="lede" style="margin-top:18px;font-size:var(--s-0)">Cuéntanos tu proyecto y te ayudaremos a encontrar la mejor solución para tu negocio.</p>
          <ul class="hero-checks" style="margin-top:22px">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><use href="#i-check"></use></svg> Respuesta en menos de 24 horas hábiles</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><use href="#i-check"></use></svg> Sin compromiso</li>
          </ul>
          <div class="direct">
            <a href="https://wa.me/56931971436">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5a1 1 0 00-.7.3c-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6a9.3 9.3 0 003.6 3.2c1.7.7 1.7.5 2 .4.4 0 1.3-.5 1.5-1s.2-1 .1-1.1z"/></svg>
              Escribir por WhatsApp
              <span class="chev" aria-hidden="true">›</span>
            </a>
            <a href="tel:+56931971436">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
              (+56) 9 3197 1436
              <span class="chev" aria-hidden="true">›</span>
            </a>
            <a href="mailto:contacto@webfriends.cl">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
              contacto@webfriends.cl
              <span class="chev" aria-hidden="true">›</span>
            </a>
          </div>
        </div>

        <form id="form" novalidate>
          <div class="field">
            <label for="nombre">Nombre <span class="req" aria-hidden="true">*</span></label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="email">Correo electrónico <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-hint">
            <span class="field-hint" id="email-hint">A esta dirección enviaremos la propuesta.</span>
          </div>
          <div class="field">
            <label for="tel">Teléfono</label>
            <input id="tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="tel-hint">
            <span class="field-hint" id="tel-hint">Opcional. Solo si prefieres que te llamemos.</span>
          </div>
          <div class="field">
            <label for="interes">¿Qué te interesa?</label>
            <select id="interes" name="interes">
              <option value="general">Asesoría general</option>
              <option value="ads">Google Ads</option>
              <option value="seo">Posicionamiento SEO</option>
              <option value="web">Sitio o tienda web</option>
              <option value="uxui">Diseño UX/UI</option>
            </select>
          </div>
          <div class="field">
            <label for="msg">Mensaje</label>
            <textarea id="msg" name="msg" placeholder="Cuéntanos brevemente qué necesitas"></textarea>
          </div>
          <button class="btn btn-accent btn-block" type="submit">
            Enviar solicitud
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </button>
          <p class="field-hint" style="margin-top:12px;text-align:center">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
          <p id="form-status" role="status" aria-live="polite" style="margin-top:12px;text-align:center;font-size:var(--s--1)"></p>
        </form>
      </div>
    </div>
  </section>



<Fragment slot="scripts">
<div class="recheck-overlay" id="recheckOverlay" role="dialog" aria-modal="true" aria-labelledby="recheck-h" hidden>
  <div class="recheck-modal">
    <button class="recheck-close" id="recheckClose" type="button" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><use href="#i-close"></use></svg>
    </button>
    <div class="recheck-grid">
      <div class="recheck-text">
        <span class="logo-mark" aria-hidden="true" style="height:18px;margin-bottom:20px">
          <img class="logo-img-dark" src="/assets/img/webfriends-logo.png" alt="Webfriends" loading="lazy">
          <img class="logo-img-light" src="/assets/img/logotipo-negro-webfriends.png" alt="Webfriends" loading="lazy">
        </span>
        <p class="eyebrow">Antes que te vayas</p>
        <h2 id="recheck-h">¿Tu web funciona <em>como debería</em>?</h2>
        <p class="lede">En solo 1 minuto puedes descubrir sin costo y ver si tienes problemas de velocidad, seguridad, SEO o estructura que pueden estar dañando tu marca y haciéndote perder ventas todos los días.</p>
        <form class="recheck-form" id="recheckForm">
          <input type="text" inputmode="url" placeholder="tuempresa.cl" aria-label="Dirección de tu sitio web" required>
          <button class="btn btn-accent" type="submit">Auditar gratis
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </button>
        </form>
        <p class="recheck-note">Gratis, en 1 minuto y sin compromiso.</p>
      </div>
      <div class="recheck-report" aria-hidden="true">
        <div class="recheck-report-head">
          <span>Diagnóstico exprés</span>
          <b>tu-sitio.cl</b>
        </div>
        <div class="recheck-rings">
          <div class="recheck-ring">
            <div class="recheck-ring-viz">
              <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--fill-2)" stroke-width="7"/>
                <circle cx="32" cy="32" r="27" fill="none" stroke="#FF5A4E" stroke-width="7" stroke-linecap="round" stroke-dasharray="169.6" stroke-dashoffset="98.4" transform="rotate(-90 32 32)"/>
              </svg>
              <em>42</em>
            </div>
            <span>Rendimiento</span>
          </div>
          <div class="recheck-ring">
            <div class="recheck-ring-viz">
              <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--fill-2)" stroke-width="7"/>
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--amber)" stroke-width="7" stroke-linecap="round" stroke-dasharray="169.6" stroke-dashoffset="76.3" transform="rotate(-90 32 32)"/>
              </svg>
              <em>55</em>
            </div>
            <span>SEO</span>
          </div>
          <div class="recheck-ring">
            <div class="recheck-ring-viz">
              <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--fill-2)" stroke-width="7"/>
                <circle cx="32" cy="32" r="27" fill="none" stroke="#34C759" stroke-width="7" stroke-linecap="round" stroke-dasharray="169.6" stroke-dashoffset="49.2" transform="rotate(-90 32 32)"/>
              </svg>
              <em>71</em>
            </div>
            <span>Seguridad</span>
          </div>
          <div class="recheck-ring">
            <div class="recheck-ring-viz">
              <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--fill-2)" stroke-width="7"/>
                <circle cx="32" cy="32" r="27" fill="none" stroke="var(--amber)" stroke-width="7" stroke-linecap="round" stroke-dasharray="169.6" stroke-dashoffset="88.2" transform="rotate(-90 32 32)"/>
              </svg>
              <em>48</em>
            </div>
            <span>Conversión</span>
          </div>
        </div>
        <ul class="recheck-issues">
