---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ORG_ID, pageId } from '../../data/schema';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((p) => ({ params: { slug: p.id }, props: { producto: p } }));
}

const { producto } = Astro.props as { producto: CollectionEntry<'productos'> };
const p = producto.data;
const site = Astro.site ?? new URL(Astro.url.origin);
const productUrl = new URL(`/producto/${producto.id}/`, site).toString();
// Only publish offers for visible plans with an exact published CLP price.
const price = /^\$\d{1,3}(?:\.\d{3})*$/.test(p.price.trim())
  ? Number(p.price.replace(/[^\d]/g, ''))
  : null;
const productLd = !p.hidden && price !== null ? {
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: p.name,
  description: p.description,
  image: new URL(p.image, site).toString(),
  url: productUrl,
  mainEntityOfPage: { '@id': pageId(productUrl) },
  brand: { '@id': ORG_ID },
  offers: {
    '@type': 'Offer',
    '@id': `${productUrl}#offer`,
    url: productUrl,
    price,
    priceCurrency: 'CLP',
    seller: { '@id': ORG_ID },
    description: p.renewalTerms,
  },
} : null;

const otros = (await getCollection('productos', (o) => !o.data.hidden && o.id !== producto.id))
  .sort((a, b) => a.data.order - b.data.order);
const pages = await getCollection('pages');
const sitiosWebHref = `/${pages.find((x) => x.id === 'page-sitios-web')!.data.urlSlug}/`;
const preciosHref = `/${pages.find((x) => x.id === 'page-precios')!.data.urlSlug}/`;
---

<BaseLayout title={`${p.name} — Webfriends`} description={`${p.tagline} ${p.price}.`} noindex={p.hidden} schema={productLd ? [productLd] : []} pageExtra={productLd ? { mainEntity: { '@id': productLd['@id'] } } : {}}>
  <section class="hero hero-split grid-bg" style="padding-block:clamp(44px,6vw,80px) clamp(40px,5vw,64px);text-align:left">
    <div class="wrap hero-split-grid" data-hero-seq>
      <div>
        <p class="eyebrow"><a href={sitiosWebHref} style="color:inherit;text-decoration:none">Sitios y tiendas web</a></p>
        <h1 style="margin:0 0 22px">{p.name}</h1>
        <p class="lede" style="max-width:46ch">{p.description}</p>
        <div class="prod-price">
          <p class="plan-price">{p.price}</p>
          {p.renewalTerms && <p class="plan-renew">{p.renewalTerms}</p>}
        </div>
        <div class="hero-actions" style="justify-content:flex-start;margin-top:24px">
          <a class="btn btn-accent" href="/contacto/">Cotizar {p.name}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </a>
          <a class="btn btn-soft" href={`${preciosHref}?servicio=web`}>Armar cotización</a>
        </div>
        {p.deliveryNote && <p class="plan-fine" style="text-align:left">{p.deliveryNote}</p>}
      </div>
      <div class="prod-art" data-reveal="scale">
        <img src={p.image} alt={`Ilustración del plan ${p.name} de Webfriends`} width="1321" height="1191" />
      </div>
    </div>
  </section>

  {p.features.length > 0 && (
    <section aria-labelledby="incluye-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Qué incluye</p>
        <h2 id="incluye-h" class="h-sec" data-reveal>Todo lo que viene en {p.name}</h2>
        <ul class="prod-feats" data-reveal-group>
          {p.features.map((f) => (
            <li data-reveal="fade">
              <span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span><b>{f.label}</b>{f.description && <i>{f.description}</i>}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {p.details.length > 0 && (
    <section aria-labelledby="elegir-h">
      <div class="wrap" style="max-width:880px">
        <h2 id="elegir-h" class="h-sec">Antes de elegir {p.name}</h2>
        <div class="reading-sections">
          {p.details.map((detail) => (
            <div class="reading-section"><div>
              <h3>{detail.heading}</h3>
              {detail.paragraphs.map((text) => <p>{text}</p>)}
            </div></div>
          ))}
        </div>
        <p style="margin-top:32px">Revisa el <a href={sitiosWebHref}>servicio de sitios web</a> o <a href="/contacto/">consulta el alcance de tu proyecto</a> antes de contratar.</p>
      </div>
    </section>
  )}

  {otros.length > 0 && (
    <section class="grad-cool" aria-labelledby="otros-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Otras opciones</p>
        <h2 id="otros-h" class="h-sec" data-reveal>Compara con otros planes</h2>
        <div class="case-grid" data-reveal-group>
          {otros.map((o) => (
            <article class="case-card" data-reveal="scale">
              <h3>{o.data.name}</h3>
              <p class="case-sector">{o.data.tagline}</p>
              <p class="case-result">{o.data.price}</p>
              <a class="bento-link" href={`/producto/${o.id}/`}>Ver plan <i aria-hidden="true">›</i></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
