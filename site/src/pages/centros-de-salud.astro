    .lp-conn-join::before { left: 50%; right: auto; top: 0; bottom: 0; width: 1px; border: 0; border-left: 1px solid rgba(35, 22, 0, .4); border-radius: 0; }
    .lp-conn-join::after { display: none; }
    .lp-sticky { display: block; }
