---
// Landing para campañas de Google Ads dirigidas a centros médicos y dentales.
// Tres líneas con el mismo peso —web, SEO/GEO y Google Ads—, contratables por separado o juntas.
//
// Segunda iteración: la sección suelta de problemas se eliminó y cada problema pasó a encabezar
// su bloque de detalle, que es donde ya estaba la respuesta. Así se corta la repetición sin
// perder el enfoque en lo que le pasa al centro.
//
// Sigue siendo cerrada: la navegación del encabezado son anclas, no rutas del sitio. Los únicos
// enlaces que salen son los de los proyectos y las fuentes de los datos (pestaña nueva), el
// correo, WhatsApp y el legal.
//
// noindex SIN canonical cruzado a /salud/: las dos señales juntas son contradictorias y Google
// puede arrastrar el noindex a la página canónica. Self-canonical.
//
// Sin precios ni planes: el objetivo de cada CTA es la cotización. Sin CRM, porque no existe
// como servicio. Ambas son decisiones abiertas registradas en PRODUCT.md.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LineArt from '../components/LineArt.astro';
import Testimonials from '../components/Testimonials.astro';
import FloatButtons from '../components/FloatButtons.astro';
import WhatsAppLead from '../components/WhatsAppLead.astro';

// Casos reales y publicables del rubro (PRODUCT.md > Evidence on Hand). Las capturas son de los
// sitios en producción; `hecho` enumera solo lo que el caso documenta, sin atribuir de más.
const casos = await getCollection('casos');
const evidencia = [
  {
    ...casos.find((c) => c.id === 'ceapsi')!.data,
    shot: 'ceapsi-d.webp',
    url: 'https://ceapsi.cl/',
    hecho: ['Sitio web', 'SEO / GEO', 'Google Ads'],
  },
  {
    ...casos.find((c) => c.id === 'liv-salud')!.data,
    shot: 'livsalud-d.webp',
    url: 'https://livsalud.cl/',
    hecho: ['Sitio web', 'Google Ads'],
  },
];

// Navegación del encabezado. Son anclas: ayudan a recorrer la página sin sacar a nadie de ella.
// Van en el mismo orden en que aparecen en la pagina.
const nav = [
  { id: 'servicios', t: 'Servicios' },
  { id: 'proyectos', t: 'Proyectos' },
  { id: 'datos', t: 'Protección de datos' },
  { id: 'dudas', t: 'Preguntas frecuentes' },
];

// Las tres líneas. `v` es el valor del checkbox del formulario final, al que apunta cada CTA con
// data-need. El nombre del servicio va primero y literal: se reconoce sin leer la tarjeta entera.
const soluciones = [
  {
    v: 'web',
    art: 'web-1',
    nombre: 'Sitios web',
    t: 'Una web que facilite elegir y reservar.',
    d: 'Creamos o actualizamos tu sitio para que sea rápido, claro y cómodo desde el celular.',
    items: ['Creación o renovación', 'Fichas de profesionales', 'Acceso a tu agenda'],
    cta: 'Cotizar sitio web',
  },
  {
    v: 'seo',
    art: 'seo-1',
    nombre: 'SEO / GEO',
    t: 'Haz más fácil que encuentren tu centro.',
    d: 'Trabajamos tu visibilidad orgánica en Google y la claridad de tu información para buscadores y respuestas de IA.',
    items: ['Especialidades y sedes', 'Contenidos útiles', 'Estructura técnica'],
    cta: 'Cotizar SEO / GEO',
  },
  {
    v: 'ads',
    art: 'ads',
    nombre: 'Google Ads',
    t: 'Conecta con quienes buscan atención.',
    d: 'Creamos campañas orientadas a tus servicios y sedes, con seguimiento de los contactos que sea posible medir.',
    items: ['Búsquedas relevantes', 'Campañas por servicio', 'Medición y ajustes'],
    cta: 'Cotizar Google Ads',
  },
];

// Datos de terceros. Se publican con su fuente, su año y su alcance a la vista, porque ninguno es
// de Webfriends ni de Chile: son referencias generales de comportamiento. `nota` solo aparece
// cuando el dato necesita una aclaración de alcance para no leerse de más.
const datos = [
  {
    n: '53 %',
    d: 'De las visitas móviles se abandonaban cuando la página tardaba más de 3 segundos en cargar.',
    fuente: 'Google/DoubleClick · 2017',
    url: 'https://blog.google/products/adsense/the-ultimate-mobile-page-speed-infographic/',
    nota: 'Dato general de navegación móvil.',
  },
  {
    n: '80 %',
    d: 'De los pacientes encuestados querían agendar en cualquier momento desde casa o un dispositivo móvil.',
    fuente: 'Experian Health · 2025 · EE. UU.',
    url: 'https://www.experian.com/blogs/healthcare/qa-state-of-patient-access-2025-insights-and-challenges/',
    nota: '',
  },
  {
    n: '3 de cada 4',
    d: 'Personas encuestadas habían buscado online información sobre médicos, dentistas o atención médica.',
    fuente: 'PatientPop · 2021 · EE. UU.',
    url: 'https://www.prnewswire.com/news-releases/patientpop-third-annual-patient-perspective-survey-report-reveals-what-patients-want-in-2021-301320469.html',
    nota: '',
  },
];

// Clientes del rubro salud. Los archivos ya están en el repo y se usan en la cinta del inicio.
// Van como logotipos sin enlace: en tráfico pagado cada enlace que sale es un clic comprado que
// se va, y los dos proyectos de más arriba ya ofrecen la comprobación con su enlace.
const clientes = [
  { n: 'CEAPSI', logo: 'ceapsi.webp' },
  { n: 'Liv Salud', logo: 'livsalud.webp' },
  { n: 'Familia Salud', logo: 'familiasalud.webp' },
  { n: 'Clinit', logo: 'clinit.webp' },
  { n: 'Insignare', logo: 'insignare.webp' },
  { n: 'Novamente', logo: 'novamente.webp' },
  { n: 'MirAndes', logo: 'mirandes.webp' },
];

// Sistemas de agenda con los que el centro puede llegar. Son marcas de terceros: se nombran para
// decir con qué nos vinculamos (uso nominativo), sin implicar alianza ni certificación.
const agendas = [
  { n: 'Medilink', logo: 'medilink.webp' },
  { n: 'AgendaPro', logo: 'agendapro.webp' },
  { n: 'Reservo', logo: 'reservo.webp' },
];

// Opciones del formulario final. Selección múltiple; `interes` resuelve el asunto del correo
// contra la lista cerrada INTERESES de public/api/contacto.php.
const ayudas = [
  { v: 'web', t: 'Sitio web', interes: 'salud' },
  { v: 'seo', t: 'SEO / GEO', interes: 'seo' },
  { v: 'ads', t: 'Google Ads', interes: 'ads' },
  { v: 'privacidad', t: 'Revisión técnica de privacidad de mi sitio', interes: 'privacidad' },
  { v: 'orientacion', t: 'Necesito orientación', interes: 'salud' },
];

// Ley 21.719 sobre protección de datos personales.
//
// OJO, HAY QUE VERIFICAR ESTA FECHA ANTES DE PUBLICAR. Es la entrada en vigencia que aparece en
// el texto legal consultado en la BCN, pero hay modificaciones legislativas en trámite que
// podrían moverla. Por eso vive aquí como dato suelto y con su enlace a la fuente oficial: si
// cambia, se corrige esta línea y nada más. No se usa para ninguna cuenta regresiva.
const leyVigencia = '1 de diciembre de 2026';
const leyFuente = 'https://www.bcn.cl/leychile/Navegar?idNorma=1209272';

// Lo que se revisa es el sitio: cómo pide, recibe y transmite datos. No es una evaluación
// jurídica ni cubre el tratamiento de datos dentro de la organización.
const revisiones = [
  'Formularios que soliciten solo la información necesaria.',
  'Información de privacidad clara y accesible.',
  'Gestión del consentimiento cuando corresponda.',
  'Revisión de herramientas de medición y servicios externos.',
];

const faqs = [
  {
    q: '¿Puedo contratar solo uno de los servicios?',
    a: 'Sí. Web, SEO / GEO y Google Ads se contratan por separado. Si más adelante quieres sumar otra línea, se agrega sobre lo que ya está hecho.',
  },
  {
    q: '¿Pueden mejorar el sitio que ya tengo?',
    a: 'Sí. Revisamos el sitio actual y te decimos qué conviene: corregir sobre lo existente, o rehacerlo cuando la base ya no lo permite.',
  },
  {
    q: '¿Necesito cambiar mi sistema de agenda?',
    a: 'No. Trabajamos sobre el sistema que tu equipo ya usa. Según lo que permita esa plataforma, la vinculación puede ser un enlace, una agenda incrustada o una integración técnica.',
  },
  {
    q: '¿Cuál es la diferencia entre SEO / GEO y Google Ads?',
    a: 'SEO / GEO trabaja la visibilidad no pagada: toma tiempo y se sostiene cuando paras de invertir. Google Ads es tráfico pagado: aparece desde el día uno y se detiene cuando se apaga la campaña.',
  },
  {
    q: '¿Pueden trabajar con varias sucursales?',
    a: 'Sí. Cada sede puede tener su propia página, su información local y su medición.',
  },
  {
    q: '¿Cómo definen qué necesita mi centro?',
    a: 'Partimos con una reunión en línea: revisamos tu sitio, tu presencia en Google y tu sistema de agenda, y te decimos por dónde conviene empezar. De ahí sale la cotización, con alcance y plazo.',
  },
];
---

<BaseLayout
  bare
  noindex
  title="Sitios web, SEO / GEO y Google Ads para centros de salud — Webfriends"
  description="Más visibilidad para tu centro y un camino más fácil hacia la consulta. Creamos y actualizamos sitios web, trabajamos tu visibilidad en Google y en respuestas de IA, y desarrollamos campañas de Google Ads para clínicas y centros de salud de Chile. Cotiza sin costo."
  ogImage="/assets/img/og-centros-de-salud.jpg"
  ogImageAlt="Webfriends para clínicas y centros de salud: sitios web, SEO / GEO y Google Ads. Google Partner hace 7 años."
>
  <!-- Encabezado. La navegación son anclas de esta misma página: no hay rutas de salida. -->
  <header class="lp-head">
    <div class="lp-wrap lp-head-in">
      <!-- Sin href: el logotipo es la marca, no una puerta de salida. -->
      <span class="lp-brand">
        <img class="lp-brand-dark" src="/assets/img/webfriends-logo.webp" alt="Webfriends" width="481" height="61" />
        <img class="lp-brand-light" src="/assets/img/logotipo-negro-webfriends.webp" alt="Webfriends" width="400" height="52" />
      </span>

      <nav class="lp-nav" aria-label="Secciones de esta página">
        <ul>
          {nav.map((n) => <li><a href={`#${n.id}`}>{n.t}</a></li>)}
        </ul>
      </nav>

      <a class="btn btn-accent lp-head-cta" href="#cotizar">Cotizar solución</a>

      <!-- Menú móvil: panel lateral que entra desde la derecha. El mecanismo sigue siendo
           <details>, que es accesible por teclado y anunciable, y funciona aunque el JavaScript
           no cargue; el script solo agrega el cierre animado, el bloqueo del scroll y el foco. -->
      <details class="lp-menu">
        <summary aria-label="Abrir menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <span class="lp-menu-bg" aria-hidden="true"></span>
        <div class="lp-menu-panel">
          <div class="lp-menu-top">
            <span class="lp-menu-rot">Menú</span>
            <button class="lp-menu-x" type="button" aria-label="Cerrar menú">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
            </button>
          </div>
          <ul>
            {nav.map((n) => <li><a href={`#${n.id}`}>{n.t}</a></li>)}
          </ul>
          <a class="btn btn-accent lp-menu-cta" href="#cotizar">Cotizar solución</a>
        </div>
      </details>
    </div>
  </header>

  <section class="lp-hero">
    <div class="lp-wrap lp-hero-in">
      <div class="lp-hero-copy" data-reveal>
        <h1><span class="lp-sub-ray">Más visibilidad</span> para tu centro.<br />Un camino <span class="lp-sub-ray">más fácil</span> hacia la consulta.</h1>
        <p class="lp-lede">
          Sitios web, SEO / GEO y Google Ads para clínicas y centros de salud. Trabajamos cada
          solución por separado o conectadas según tus objetivos.
        </p>
        <div class="lp-hero-ctas">
          <a class="btn btn-accent" href="#cotizar">Cotizar solución</a>
          <a class="btn btn-soft" href="#servicios">Explorar servicios</a>
        </div>
        <ul class="lp-trust">
          <li class="is-partner"><span><strong>Google Partner</strong> hace 7 años</span></li>
          <li><span><strong>4,4 de 5</strong> en Google, con 18 reseñas</span></li>
          <li><span>Respuesta en <strong>menos de 24 horas hábiles</strong></span></li>
        </ul>
      </div>

      <!-- Composición de las tres áreas con el mismo peso. Se entiende por formas y etiquetas: sin
           textos diminutos ni cifras. Todo es maqueta y va rotulado como tal. -->
      <div class="lp-compo" aria-hidden="true" data-reveal>
        <div class="lp-compo-card is-web">
          <span class="lp-compo-tag">Sitio web</span>
          <div class="lp-compo-pro">
            <span class="lp-compo-av"></span>
            <span class="lp-bar is-w70"></span>
            <span class="lp-bar is-w40 is-acc"></span>
          </div>
          <!-- Las filas de la ficha: sin ellas la tarjeta quedaba con un hueco bajo el nombre. -->
          <div class="lp-compo-rows">
            <span><em></em><i class="lp-bar is-w75"></i></span>
            <span><em></em><i class="lp-bar is-w55"></i></span>
            <span><em></em><i class="lp-bar is-w85"></i></span>
          </div>
          <span class="lp-compo-btn">Reservar hora</span>
        </div>

        <div class="lp-compo-card is-seo">
          <span class="lp-compo-tag">SEO / GEO</span>
          <div class="lp-compo-res">
            <span class="lp-bar is-w60 is-acc"></span>
            <span class="lp-bar is-w90"></span>
            <span class="lp-bar is-w75"></span>
          </div>
          <div class="lp-compo-ia">
            <span class="lp-compo-spark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" /></svg>
            </span>
            <span class="lp-bar is-w80"></span>
            <span class="lp-bar is-w55"></span>
          </div>
        </div>

        <div class="lp-compo-card is-ads">
          <span class="lp-compo-tag">Google Ads</span>
          <div class="lp-compo-ad">
            <span class="lp-compo-pill">Anuncio</span>
            <span class="lp-bar is-w65 is-acc"></span>
            <span class="lp-bar is-w85"></span>
          </div>
        </div>
      </div>
      <p class="lp-compo-note">Composición ilustrativa de las tres soluciones. No representa resultados reales.</p>
    </div>
  </section>

  <!-- Cinta de clientes. Dos pistas idénticas en bucle: la segunda es decorativa y queda fuera
       del árbol de accesibilidad para que un lector de pantalla no lea la lista dos veces.
       Con prefers-reduced-motion la segunda desaparece y la primera se acomoda en una fila
       estática: el contenido nunca depende del movimiento. -->
  <section class="lp-logos" aria-labelledby="lp-logos-h">
    <div class="lp-wrap">
      <h2 id="lp-logos-h" class="lp-logos-h">Centros de salud que confían en nosotros</h2>
    </div>
    <div class="lp-marquee">
      {[false, true].map((copia) => (
        <ul class="lp-track" aria-hidden={copia ? 'true' : undefined}>
          {clientes.map((c) => (
            <li><img src={`/assets/img/${c.logo}`} alt={copia ? '' : c.n} width="200" height="100" loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="lp-band" id="servicios" aria-labelledby="lp-sol-h">
    <div class="lp-wrap">
      <h2 id="lp-sol-h">Tres servicios, uno o todos</h2>
      <p class="lp-sub">Elige por dónde empezar. Cada uno funciona solo.</p>
      <div class="lp-sol-grid">
        {soluciones.map((s) => (
          <article class="lp-sol" data-reveal>
            <span class="lp-sol-art" aria-hidden="true"><LineArt name={s.art} class="lp-art" /></span>
            <h3>{s.nombre}</h3>
            <p class="lp-sol-d"><strong>{s.t}</strong> {s.d}</p>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-soft lp-sol-cta" href="#cotizar" data-need={s.v}>{s.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-connect" aria-labelledby="lp-conn-h">
    <div class="lp-wrap">
      <h2 id="lp-conn-h">Tres soluciones. Una estrategia para tu centro.</h2>
      <p class="lp-sub lp-sub-on">
        Gana visibilidad, presenta tu atención con claridad y facilita el contacto o la reserva.
      </p>
      <div class="lp-conn" data-reveal>
        <div class="lp-conn-src">
          <article><h3>Búsqueda orgánica</h3><p>SEO / GEO</p></article>
          <article><h3>Publicidad</h3><p>Google Ads</p></article>
        </div>
        <span class="lp-conn-join" aria-hidden="true"></span>
        <article class="lp-conn-dest">
          <h3>Tu sitio web</h3>
          <p>Donde la persona conoce tu atención y da el paso: contacto o reserva.</p>
        </article>
      </div>
      <p class="lp-conn-close">Empieza por lo que necesitas. Conecta más soluciones cuando tenga sentido.</p>
    </div>
  </section>

  <!-- Detalle 1: SITIOS WEB. Dos columnas equilibradas; en móvil el mensaje va antes que la
       demostración, por eso la demostración viene después en el orden del documento. -->
  <section class="lp-deep" id="web" aria-labelledby="lp-web-h">
    <div class="lp-wrap lp-deep-in">
      <div class="lp-deep-copy" data-reveal>
        <h2 id="lp-web-h"><span class="lp-deep-svc">Sitios web.</span> ¿Tu sitio demora o cuesta usarlo?</h2>
        <p class="lp-deep-d">
          Cuando encontrar una especialidad toma tres clics, la persona se va antes de llegar.
          Creamos el sitio desde cero o renovamos el que ya tienes.
        </p>
        <ul class="lp-benes">
          <li><strong>Elegir sin buscar.</strong> Especialidades, sedes y profesionales a la vista.</li>
          <li><strong>Rápido en el celular.</strong> Donde ocurre la mitad de las visitas.</li>
          <li><strong>Conectado a tu agenda.</strong> Sin cambiar de sistema.</li>
        </ul>
        <a class="btn btn-accent" href="#cotizar" data-need="web">Cotizar sitio web</a>
      </div>

      <div class="lp-demo" data-reveal>
        <div class="lp-demo-frame">
          <!-- Ficha de profesional: la pieza que la persona necesita leer para decidir. -->
          <div class="lp-pro">
            <span class="lp-pro-av" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg>
            </span>
            <div class="lp-pro-id">
              <p class="lp-pro-n">Dra. Nombre Apellido</p>
              <p class="lp-pro-e">Traumatología</p>
            </div>
            <dl class="lp-pro-meta">
              <div><dt>Modalidad</dt><dd>Presencial y telemedicina</dd></div>
              <div><dt>Sede</dt><dd>Centro · Norte</dd></div>
              <div><dt>Previsión</dt><dd>Fonasa · Isapres · Particular</dd></div>
            </dl>
            <span class="lp-pro-btn">Reservar hora</span>
          </div>
          <p class="lp-demo-cap">Ejemplo ilustrativo. Los datos no corresponden a una persona real.</p>
        </div>

        <div class="lp-demo-aside">
          <p class="lp-demo-h">Dos puntos de partida</p>
          <div class="lp-paths">
            <span><strong>Crear un sitio nuevo</strong>Cuando no hay sitio o la base ya no da más.</span>
            <span><strong>Actualizar mi sitio</strong>Cuando funciona, pero cuesta usarlo.</span>
          </div>

          <p class="lp-demo-h is-second">Vinculación con tu agenda</p>
          <ul class="lp-agenda-row">
            {agendas.map((a) => (
              <li><img src={`/assets/img/agendas/${a.logo}`} alt={a.n} width="200" height="100" loading="lazy" decoding="async" /></li>
            ))}
            <li class="is-more"><span>y otros</span></li>
          </ul>
          <p class="lp-note">
            El tipo de conexión depende de cada plataforma: un enlace, una agenda incrustada o una
            integración técnica. Lo revisamos antes de comprometer nada. No tenemos alianza
            comercial con estas marcas, que pertenecen a sus titulares.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detalle 2: SEO / GEO -->
  <section class="lp-deep is-alt" id="seo" aria-labelledby="lp-seo-h">
    <div class="lp-wrap lp-deep-in">
      <div class="lp-deep-copy" data-reveal>
        <h2 id="lp-seo-h"><span class="lp-deep-svc">SEO / GEO.</span> ¿Tu centro es difícil de encontrar?</h2>
        <p class="lp-deep-d">
          Para aparecer en un buscador o en una respuesta de IA, la información de tu centro tiene
          que estar escrita de forma que se entienda. Eso es lo que ordenamos.
        </p>
        <ul class="lp-benes">
          <li><strong>Una página por especialidad y sede.</strong> Para que cada búsqueda tenga dónde llegar.</li>
          <li><strong>Respuestas a lo que preguntan.</strong> Previsión, derivación, horarios.</li>
          <li><strong>Estructura técnica ordenada.</strong> La que leen los buscadores y los modelos.</li>
        </ul>
        <p class="lp-note">
          No prometemos primeros lugares ni apariciones garantizadas en IA: no dependen de nosotros.
        </p>
        <a class="btn btn-accent" href="#cotizar" data-need="seo">Cotizar SEO / GEO</a>
      </div>

      <div class="lp-demo" data-reveal>
        <div class="lp-demo-frame">
          <p class="lp-demo-h">Cómo se ordena tu información</p>
          <ul class="lp-tree">
            <li>Especialidad<span>traumatología, dental, nutrición</span></li>
            <li>Profesional<span>ficha propia, con sus sedes</span></li>
            <li>Sede<span>una página por punto de atención</span></li>
            <li>Preguntas frecuentes<span>previsión, derivación, horarios</span></li>
          </ul>
        </div>

        <div class="lp-demo-aside">
          <p class="lp-demo-h">Dónde se nota</p>
          <div class="lp-surf" aria-hidden="true">
