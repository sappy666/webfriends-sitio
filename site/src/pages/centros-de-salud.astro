  .lp-step-ico { display: flex; align-items: center; height: 64px; margin: 18px 0 14px; color: var(--label-3); }
  .lp-step-ico :global(.lp-step-art) { width: 84px; }
  .lp-step-ico > svg { width: 34px; height: 34px; }
  .lp-step h3 { margin: 0 0 8px; font-size: var(--s-1); letter-spacing: -.03em; }
  .lp-step p { margin: 0 0 16px; color: var(--label-2); line-height: 1.55; }
  .lp-step-ctas { margin-top: auto; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .lp-step-ctas a { font-weight: 700; font-size: .92rem; color: var(--amber); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; min-height: 24px; }

  /* Recorrido */
  .lp-demo { padding-block: clamp(40px, 6vw, 72px); }
  .lp-demo-sub { margin: -14px 0 28px; color: var(--label-2); max-width: 56ch; }
  .lp-demo-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 52px); align-items: start; }

  .lp-friction { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 1px; background: var(--line-2); border: 1px solid var(--line-2); border-radius: var(--r-md); overflow: hidden; }
  .lp-friction li { background: var(--bg); padding: 18px 20px; }
  .lp-q { margin: 0; font-size: var(--s-0); font-weight: 600; letter-spacing: -.02em; }
  .lp-a { margin: 6px 0 0; color: var(--label-2); line-height: 1.5; }

  .lp-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 1px; background: var(--line-2); border: 1px solid var(--line-2); border-radius: var(--r-md); overflow: hidden; }
  .lp-radio { position: absolute; opacity: 0; pointer-events: none; }
  .lp-step-tab { grid-row: 1; background: var(--bg); padding: 16px 14px; cursor: pointer; display: flex; flex-direction: column; gap: 6px; font-size: .95rem; font-weight: 600; letter-spacing: -.02em; min-height: 44px; }
  .lp-step-n { font-size: .79rem; font-weight: 700; color: var(--label-3); }
  .lp-step-panel { grid-row: 2; grid-column: 1 / -1; background: var(--bg); padding: 0 18px 20px; display: none; }
  .lp-step-panel p { margin: 0; color: var(--label-2); line-height: 1.6; }
  .lp-radio:checked + .lp-step-tab { background: var(--fill); }
  .lp-radio:checked + .lp-step-tab .lp-step-n { color: var(--amber); }
  .lp-radio:checked + .lp-step-tab + .lp-step-panel { display: block; }
  .lp-radio:focus-visible + .lp-step-tab { outline: 2px solid var(--amber); outline-offset: -3px; }

  .lp-shot { margin: 0; position: relative; }
  .lp-shot img { display: block; width: 100%; height: auto; border: 1px solid var(--line-2); border-radius: var(--r-md); }
  /* .lp-shot .lp-shot-m y no .lp-shot-m a secas: la regla con ambito .lp-shot img queda en
     (0,3,1) y le ganaba al 27%, dejando la captura de celular al 100% y desbordada. */
  .lp-shot .lp-shot-m { position: absolute; right: -10px; bottom: 30px; width: 26%; border-radius: 14px; box-shadow: var(--sh-3); }
  .lp-shot figcaption { margin-top: 14px; font-size: .82rem; color: var(--label-3); }

  /* Integraciones de agenda */
  .lp-agendas { padding-block: clamp(36px, 5vw, 60px); }
  .lp-agendas-sub { margin: -14px 0 26px; color: var(--label-2); line-height: 1.6; max-width: 62ch; }
  .lp-agenda-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .lp-agenda-row li { display: flex; align-items: center; justify-content: center; min-width: 150px; min-height: 68px; padding: 0 22px; border: 1px solid var(--line-2); border-radius: var(--r-md); background: var(--card); }
  /* Mientras no existan los archivos, el nombre va compuesto: legible y sin inventar una marca. */
  .lp-agenda-row span { font-size: var(--s-1); font-weight: 600; letter-spacing: -.03em; color: var(--label); }
  /* Los tres archivos son blancos sobre transparente, pensados para fondo oscuro: en tema claro
     se invierten a negro, igual que la cinta de clientes del inicio. Sin esto no se ven. */
  .lp-agenda-row img { width: 100%; max-width: 132px; height: auto; display: block; }
  :global(:root:not([data-theme="dark"])) .lp-agenda-row img { filter: grayscale(1) brightness(0); }
  .lp-agenda-row .is-more { background: none; border-style: dashed; }
  .lp-agenda-row .is-more span { color: var(--label-3); font-weight: 500; font-size: var(--s-0); }
  .lp-agendas-note { margin: 20px 0 0; font-size: .82rem; line-height: 1.55; color: var(--label-3); max-width: 76ch; }

  /* Proyectos */
  .lp-cases { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .lp-case { background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 26px 24px; }
  .lp-case-logo { display: block; width: 120px; height: auto; margin-bottom: 16px; }
  :global(:root:not([data-theme="dark"])) .lp-case-logo { filter: grayscale(1) brightness(0); }
  :global(:root[data-theme="dark"]) .lp-case-logo { filter: grayscale(1) brightness(0) invert(1); }
  .lp-case-tag { margin: 0 0 2px; font-size: .82rem; font-weight: 700; color: var(--amber); }
  .lp-case-sector { margin: 0 0 14px; font-size: .88rem; color: var(--label-3); }
  .lp-case-text { margin: 0 0 14px; color: var(--label-2); line-height: 1.55; }
  .lp-case ul { margin: 0 0 14px; padding-left: 18px; color: var(--label-2); line-height: 1.7; }
  .lp-case-result { margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-weight: 600; }
  .lp-case-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 14px; min-height: 44px; font-size: .92rem; font-weight: 700; color: var(--amber); text-decoration: none; }
  .lp-case-link svg { width: 15px; height: 15px; flex: none; transition: transform .25s var(--ease); }
  .lp-case-link:hover svg, .lp-case-link:focus-visible svg { transform: translate(2px, -2px); }
  .lp-case-link:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 6px; }

  /* Planes */
  .lp-plans { padding-block: clamp(40px, 6vw, 72px); }
  .lp-plans-sub { margin: -14px 0 26px; color: var(--label-2); max-width: 54ch; }
  .lp-plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .lp-plan { background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 24px 22px; }
  .lp-plan.is-featured { border-color: var(--amber); }
  .lp-plan h3 { margin: 0 0 10px; font-size: var(--s-1); letter-spacing: -.03em; }
  .lp-plan p { margin: 0; color: var(--label-2); line-height: 1.55; }
  .lp-plan-note { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: .85rem; font-weight: 600; color: var(--label); }

  /* Dudas */
  .lp-list { border-top: 1px solid var(--line-2); }
  .lp-row { border-bottom: 1px solid var(--line-2); }
  .lp-row summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 2px; cursor: pointer; font-size: var(--s-1); font-weight: 600; letter-spacing: -.02em; list-style: none; min-height: 44px; }
  .lp-row summary::-webkit-details-marker { display: none; }
  .lp-row summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; border-radius: 6px; }
  .lp-chev { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line-2); color: var(--label-2); display: grid; place-items: center; transition: transform .3s var(--ease), border-color .3s; }
  .lp-chev svg { width: 15px; height: 15px; }
  .lp-row[open] .lp-chev { transform: rotate(180deg); border-color: var(--amber); color: var(--amber); }
  .lp-row p { margin: 0 0 22px; padding-right: 50px; color: var(--label-2); line-height: 1.6; max-width: 70ch; }
  .lp-close { margin: clamp(24px, 4vw, 36px) 0 0; color: var(--label-3); }
  .lp-close a { color: var(--amber); font-weight: 700; text-decoration: none; }

  .lp-foot { padding-block: 24px 96px; }
  .lp-foot p { margin: 0; font-size: .79rem; color: var(--label-3); }

  /* Barra fija con la acción */
  .lp-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 12px clamp(16px, 4vw, 40px); background: var(--glass-bar); border-top: 1px solid var(--line-2); backdrop-filter: saturate(160%) blur(12px); }
  .lp-sticky p { margin: 0; font-weight: 600; color: var(--label-2); font-size: .92rem; }
  .lp-sticky .btn { min-height: 46px; margin: 0; }

  @media (max-width: 980px) {
    .lp-demo-split, .lp-promise-grid { grid-template-columns: 1fr; }
    /* Vertical: el conector pasa a ser una línea a la izquierda y las etapas se indentan. */
    .lp-path { grid-template-columns: 1fr; gap: 0; }
    .lp-path::before { left: 21px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .lp-step { flex-direction: row; flex-wrap: wrap; gap: 0 18px; padding-bottom: 28px; }
    .lp-step-num { grid-row: auto; }
    .lp-step-ico { display: none; }
    .lp-step h3, .lp-step p, .lp-step-ctas { width: calc(100% - 60px); margin-left: auto; }
    .lp-step h3 { margin-top: 8px; }
    .lp-step-ctas { flex-direction: row; flex-wrap: wrap; gap: 8px 18px; margin-top: 0; }
    .lp-plan-grid { grid-template-columns: 1fr; }
    .lp-cases, .lp-doors { grid-template-columns: 1fr; }
    .lp-agenda-row li { flex: 1 1 140px; min-width: 0; }
  }

  @media (max-width: 920px) {
    .lp-split { grid-template-columns: 1fr; gap: 24px; }
    .lp-answer h1 { font-size: var(--s-2); max-width: 20ch; }
    .lp-lede { margin-top: 14px; font-size: var(--s-0); }
    .lp-fact { margin-top: 18px; }
    /* Las credenciales bajan tras el formulario: la regla del modo Persuade pide la acción dentro
       de la primera pantalla, y en un teléfono de 667px de alto estos ~70px la empujaban fuera. */
    .lp-answer { display: contents; }
    .lp-form-card { order: 2; }
    .lp-trust { order: 3; margin-top: 18px; }
    .lp-steps { grid-template-columns: 1fr; gap: 1px; }
    .lp-step-tab, .lp-step-panel { grid-row: auto; grid-column: 1; }
    .lp-shot .lp-shot-m { right: 0; bottom: 24px; width: 30%; }
    .lp-sticky p { display: none; }
    .lp-sticky .btn { width: 100%; justify-content: center; }
  }

  @media (max-width: 480px) {
    .lp-brand { margin-bottom: 20px; }
    .lp-hero { padding-block: 16px 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .lp-chev, .lp-index a, .lp-chip span, .lp-case-link svg { transition: none; }
    .lp-go:hover { transform: none; }
  }
</style>

<script define:vars={{ necesidades }}>
  /* Preselección: al pulsar "Cotizar Google Ads" en una tarjeta, el formulario de arriba llega
     con esa opción ya marcada. Sin JavaScript el ancla igual baja al formulario, solo que la
     persona elige a mano: mejora progresiva, no requisito. */
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-need]');
      if (!a) return;
      var r = document.querySelector('input[name="necesidad"][value="' + a.getAttribute('data-need') + '"]');
      if (r) r.checked = true;
    });
  })();

  /* El envío de la landing. Mismas tres reglas que el chat flotante del sitio:
       1. window.open va SÍNCRONO dentro del submit; tras un await el navegador lo bloquea.
       2. El fetch del correo va antes y no se espera (keepalive), así sobrevive al cambio de foco.
       3. Si el correo falla, WhatsApp se abre igual: nunca se pierde el contacto. */
  (function () {
    var form = document.getElementById('lpForm');
    if (!(form instanceof HTMLFormElement)) return;
    var nombreEl = document.getElementById('lpNombre');
    var telEl = document.getElementById('lpTel');
    var status = document.getElementById('lpStatus');

    /* Chile: celular de 9 dígitos que parte con 9, con o sin +56. Devuelve 569XXXXXXXX. */
    function normalizarTel(raw) {
      var d = String(raw).replace(/\D/g, '');
      if (d.length === 9 && d.charAt(0) === '9') return '56' + d;
      if (d.length === 11 && d.indexOf('569') === 0) return d;
      return null;
    }
    function bonito(t) { return '+56 9 ' + t.slice(3, 7) + ' ' + t.slice(7); }
    function track(ev, params) { if (typeof window.wfTrack === 'function') window.wfTrack(ev, params); }
    function waUrl(msg) {
      if (typeof window.wfWhatsAppUrl === 'function') return window.wfWhatsAppUrl(msg);
      return 'https://wa.me/56931971436?text=' + encodeURIComponent(msg);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      status.textContent = '';
      nombreEl.removeAttribute('aria-invalid');
      telEl.removeAttribute('aria-invalid');

      var nombre = nombreEl.value.trim();
      if (!nombre) {
        status.textContent = 'Falta tu nombre para poder responderte.';
        nombreEl.setAttribute('aria-invalid', 'true');
        nombreEl.focus();
        return;
      }
      var tel = normalizarTel(telEl.value);
      if (!tel) {
        status.textContent = 'Revisa el celular: debe ser un número chileno, como +56 9 1234 5678.';
        telEl.setAttribute('aria-invalid', 'true');
        telEl.focus();
        return;
      }

      var sel = form.querySelector('input[name="necesidad"]:checked');
      var elegida = necesidades.filter(function (n) { return sel && n.v === sel.value; })[0] || necesidades[0];

      /* Los mismos nombres de evento que el resto del sitio usa como conversión, para que el
         activador de Google Ads no dependa de uno que solo existe en esta página. */
      track('wf_cta_continue', { interes: elegida.interes, necesidad: elegida.v, surface: 'landing-salud' });
      track('generate_lead', { form_kind: 'landing-salud' });

      var datos = new FormData();
      datos.set('form', 'whatsapp');
      datos.set('nombre', nombre);
      datos.set('tel', tel);
      datos.set('interes', elegida.interes);
      datos.set('msg', 'Landing de centros de salud (Google Ads). ' + elegida.frase + '.');
      datos.set('website', document.getElementById('lpWebsite').value);
      datos.set('pagina', document.title + ' (' + location.pathname + ')');
      datos.set('e', String(Math.round(performance.now())));
      fetch('/api/contacto.php', { method: 'POST', body: datos, credentials: 'same-origin', keepalive: true }).catch(function () {});

      var msg = 'Hola, mi nombre es ' + nombre + ' y administro un centro de salud. '
        + elegida.frase + '. Pueden contactarme a este número: ' + bonito(tel) + '. ¡Muchas gracias!';
      track('whatsapp_click', { link_type: 'formulario' });
      window.open(waUrl(msg), '_blank', 'noopener');

      status.textContent = 'Listo: abrimos WhatsApp. Si no se abrió, escríbenos al +56 9 3197 1436.';
      form.reset();
    });
  })();
</script>
