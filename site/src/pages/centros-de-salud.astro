      <div class="lp-form-card" data-reveal>
        <form id="lpForm" novalidate>
          <fieldset class="lp-need">
            <legend>¿En qué te ayudamos?</legend>
            <div class="lp-chips">
              {ayudas.map((a) => (
                <label class="lp-chip">
                  <input type="checkbox" name="ayuda" value={a.v} />
