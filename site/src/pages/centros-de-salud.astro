    /* Teléfono y correo dejan de ser texto subrayado de 19px y pasan a botones de 54px: en este
       sitio los accesos de contacto se ampliaron a propósito tras el análisis de Clarity, y en
       el celular una línea de texto es justo lo que nadie acierta. */
    .lp-form-alt { display: grid; gap: 10px; }
    .lp-alt-o { display: none; }
