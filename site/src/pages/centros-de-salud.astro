  .lp-ley-lista li::before { content: ""; position: absolute; left: 0; top: 7px; width: 12px; height: 7px; border-left: 2px solid var(--brand); border-bottom: 2px solid var(--brand); transform: rotate(-45deg); }
  .lp-ley-nota { margin: 0; padding-top: 18px; border-top: 1px solid rgba(243, 240, 233, .16); font-size: .85rem; line-height: 1.55; color: rgba(243, 240, 233, .62); }
