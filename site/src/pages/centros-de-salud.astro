<style>
  /* Todo sale de los tokens del sitio: esta landing no inventa paleta ni tipografía. */
  .lp-wrap { max-width: 1180px; margin-inline: auto; padding-inline: clamp(20px, 5vw, 40px); }
  :global(html) { scroll-behavior: smooth; }
  /* Las anclas no quedan bajo el encabezado fijo. */
  [id] { scroll-margin-top: 84px; }

  /* El texto de apoyo sube a 1.02rem: antes quedaba por debajo del cuerpo y costaba leerlo. */
  .lp-sub { margin: -8px 0 clamp(32px, 4.5vw, 54px); font-size: 1.02rem; color: var(--label-2); line-height: 1.6; max-width: 54ch; }
  .lp-note { margin: 16px 0 0; font-size: .85rem; line-height: 1.55; color: var(--label-3); max-width: 60ch; }

  /* Encabezado fijo */
  .lp-head { position: sticky; top: 0; z-index: 40; background: var(--glass-bar); border-bottom: 1px solid var(--line-2); backdrop-filter: saturate(160%) blur(12px); }
  .lp-head-in { display: flex; align-items: center; gap: clamp(16px, 3vw, 36px); min-height: 68px; }
  .lp-brand { display: flex; align-items: center; flex: none; }
  .lp-brand img { height: 20px; width: auto; display: block; }
  /* El par claro/oscuro. Apunta a la clase y no a img: la regla con ámbito .lp-brand img queda
     en (0,3,1) y una global pelada perdía por un punto. */
  .lp-brand .lp-brand-light { display: none; }
  :global(:root:not([data-theme="dark"])) .lp-brand .lp-brand-dark { display: none; }
  :global(:root:not([data-theme="dark"])) .lp-brand .lp-brand-light { display: block; }

  .lp-nav { margin-right: auto; }
  .lp-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .lp-nav a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: .92rem; font-weight: 600; color: var(--label-2); text-decoration: none; border-radius: var(--r-sm); transition: color .2s, background-color .2s; }
  .lp-nav a:hover, .lp-nav a:focus-visible { color: var(--label); background: var(--fill); }
  .lp-head-cta { min-height: 44px; margin: 0; flex: none; }

  .lp-menu { display: none; margin-left: auto; }
  .lp-menu summary { list-style: none; display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--line-2); border-radius: var(--r-sm); cursor: pointer; color: var(--label); }
  .lp-menu summary::-webkit-details-marker { display: none; }
  .lp-menu summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .lp-menu summary svg { width: 22px; height: 22px; }

  /* Un elemento con backdrop-filter se convierte en el marco de referencia de sus descendientes
     position:fixed. Con el filtro puesto, el velo y el panel se median contra los 68px del
     encabezado en vez de contra la pantalla: el velo tapaba solo esa franja y el resto de la
     pagina seguia recibiendo toques. Mientras el panel esta abierto el desenfoque no hace falta,
     porque el velo ya cubre todo. */
  .lp-head:has(.lp-menu[open]) { backdrop-filter: none; -webkit-backdrop-filter: none; }

  /* Velo: oscurece la página y recibe el toque para cerrar. */
  .lp-menu-bg { position: fixed; inset: 0; z-index: 50; background: rgba(23, 23, 23, .5); backdrop-filter: blur(2px); opacity: 1; transition: opacity .3s var(--ease); }
  @starting-style { .lp-menu[open] .lp-menu-bg { opacity: 0; } }

  /* El panel entra desde el borde derecho. 100dvh y no 100vh: en el celular la barra del
     navegador aparece y desaparece, y con vh el panel quedaba más alto que la pantalla. */
  .lp-menu-panel { position: fixed; top: 0; right: 0; z-index: 51; height: 100dvh; width: min(86vw, 340px);
                   display: flex; flex-direction: column; background: var(--bg); border-left: 1px solid var(--line-2);
                   box-shadow: -24px 0 60px rgba(0, 0, 0, .22); padding: 14px 20px calc(24px + env(safe-area-inset-bottom));
                   transform: none; transition: transform .34s var(--ease); }
  @starting-style { .lp-menu[open] .lp-menu-panel { transform: translateX(100%); } }
  /* El cierre lo anima el script: <details> no renderiza sus hijos al cerrarse, así que sin esta
     clase intermedia el panel desaparecería de golpe. */
  .lp-menu.is-closing .lp-menu-panel { transform: translateX(100%); }
  .lp-menu.is-closing .lp-menu-bg { opacity: 0; }

  /* El flotante de WhatsApp y el "volver arriba" viven en z-index 200, muy por encima del panel:
     se apagan mientras esta abierto para que no floten sobre el menu. */
  :global(html.wf-menu .wa-float), :global(html.wf-menu .totop) { opacity: 0; pointer-events: none; transition: opacity .2s var(--ease); }

  .lp-menu-top { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; margin-bottom: 10px; border-bottom: 1px solid var(--line); }
  .lp-menu-rot { font-size: .76rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--label-3); }
  .lp-menu-x { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line-2); border-radius: 50%; background: none; color: var(--label); cursor: pointer; }
  .lp-menu-x svg { width: 17px; height: 17px; }
  .lp-menu-x:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .lp-menu ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .lp-menu li { border-bottom: 1px solid var(--line); }
  .lp-menu-panel a { display: flex; align-items: center; min-height: 58px; font-size: 1.05rem; font-weight: 600; letter-spacing: -.02em; color: var(--label); text-decoration: none; }
  .lp-menu-panel a:focus-visible { outline: 2px solid var(--amber); outline-offset: -2px; border-radius: 6px; }
  .lp-menu-cta { margin: auto 0 0; justify-content: center; min-height: 54px; }

  @media (prefers-reduced-motion: reduce) {
    .lp-menu-panel, .lp-menu-bg { transition: none; }
  }

  /* Hero */
  /* `overflow-x: clip` y no `hidden`: recorta lo que se sale por el costado sin convertir la
     sección en un contenedor de scroll. `isolation` crea el contexto de apilamiento para que el
     fondo quede detrás del texto y no detrás de la página. */
  .lp-hero { position: relative; isolation: isolate; display: grid; align-items: center;
             min-height: clamp(540px, 66vh, 760px);
             padding-block: clamp(48px, 7vw, 92px) clamp(52px, 7vw, 96px); overflow-x: clip; }
  .lp-hero-in { display: block; width: 100%; }
  .lp-hero-copy { max-width: 42ch; }

  .lp-hero-bg { position: absolute; inset: 0; z-index: -1; }
  .lp-hero-bg picture { display: block; height: 100%; }
  .lp-hero-bg img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 72% center; }
  /* Dos velos: uno horizontal, que mantiene negro el lado del texto y se abre hacia la escena, y
     otro que apaga el borde inferior para que la sección no termine en un canto recto contra la
     cinta de logotipos. */
  .lp-hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--bg) 10%, color-mix(in srgb, var(--bg) 97%, transparent) 40%, color-mix(in srgb, var(--bg) 62%, transparent) 60%, transparent 82%),
      linear-gradient(0deg, var(--bg) 1%, color-mix(in srgb, var(--bg) 55%, transparent) 12%, transparent 30%);
  }
  .lp-hero-copy h1 { font-size: var(--s-3); line-height: 1.08; letter-spacing: -.045em; margin: 0; }
  /* Subrayado ambar bajo las dos promesas del titular. Va con text-decoration y no con un borde,
     para que siga al texto si la frase se parte en dos lineas. */
  .lp-sub-ray { text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: .075em; text-underline-offset: .14em; text-decoration-skip-ink: none; }
  .lp-lede { margin-top: 20px; font-size: 1.06rem; line-height: 1.6; color: var(--label-2); max-width: 50ch; }
  .lp-hero-ctas { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  .lp-hero-ctas .btn { margin: 0; min-height: 54px; }
  .lp-trust { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .lp-trust li { display: flex; align-items: center; gap: 9px; font-size: .88rem; color: var(--label-2); line-height: 1.35; }
  .lp-trust strong { color: var(--label); }
  .lp-trust .is-partner { padding: 7px 13px; border: 1px solid var(--amber); border-radius: 999px; }
  .lp-trust .is-partner strong { color: var(--amber); }


  /* El destello y la etiqueta «Anuncio» siguen vivos: los usan las demostraciones de SEO / GEO
     y de Ads más abajo. */
  .lp-compo-spark { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--amber); color: var(--amber); margin-bottom: 2px; }
  .lp-compo-spark svg { width: 13px; height: 13px; }
  .lp-compo-pill { display: inline-block; padding: 3px 8px; border: 1px solid var(--line-2); border-radius: 5px; font-size: .68rem; font-weight: 700; letter-spacing: .03em; color: var(--label-3); }
  /* Las barras son el cuerpo del texto simulado: legibles como forma, ilegibles como palabra. */
  .lp-bar { display: block; height: 8px; border-radius: 4px; background: var(--fill); }
  .lp-bar.is-acc { background: var(--amber); opacity: .55; }
  .lp-bar.is-w40 { width: 40%; } .lp-bar.is-w55 { width: 55%; } .lp-bar.is-w60 { width: 60%; }
  .lp-bar.is-w65 { width: 65%; } .lp-bar.is-w70 { width: 70%; } .lp-bar.is-w75 { width: 75%; }
  .lp-bar.is-w80 { width: 80%; } .lp-bar.is-w85 { width: 85%; } .lp-bar.is-w90 { width: 90%; }
  .lp-bar.is-w95 { width: 95%; }

  .lp-band { padding-block: clamp(60px, 8vw, 112px); background: var(--bg-2); border-block: 1px solid var(--line); }
  h2 { font-size: var(--s-2); letter-spacing: -.04em; margin: 0 0 clamp(16px, 2.5vw, 26px); max-width: 20ch; }

  /* Tres servicios con el mismo peso. El nombre va primero y literal. */
  .lp-sol-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .lp-sol { position: relative; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 32px 28px 28px; transition: transform .35s var(--ease), border-color .35s, box-shadow .35s; }
  .lp-sol:hover { transform: translateY(-4px); border-color: var(--amber); box-shadow: var(--sh-2); }
  .lp-sol-art { display: block; height: 80px; margin-bottom: 20px; color: var(--label-3); }
  /* Distintivo de la tarjeta de Ads: arriba a la derecha, en el aire que deja la ilustración.
     Es una acreditación de Webfriends, no una promesa de resultado. */
  .lp-sol-badge { position: absolute; top: 24px; right: 22px; display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border: 1px solid var(--amber); border-radius: 999px; font-size: .76rem; font-weight: 700; letter-spacing: -.01em; color: var(--amber); }
  .lp-sol-badge svg { width: 14px; height: 14px; flex: none; }
  .lp-sol-art :global(.lp-art) { width: 90px; }
  /* El nombre del servicio ES el encabezado: se reconoce de un vistazo y la promesa abre el
     cuerpo en negrita. Antes iba como etiqueta sobre el titulo, que es justo lo que el titulo
     tiene que hacer solo. */
  .lp-sol h3 { margin: 0 0 12px; font-size: var(--s-1); letter-spacing: -.03em; line-height: 1.2; color: var(--amber); }
  .lp-sol-d { margin: 0 0 20px; font-size: .98rem; color: var(--label-2); line-height: 1.6; }
  .lp-sol-d strong { color: var(--label); font-weight: 600; }
  .lp-sol ul { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 9px; }
  .lp-sol ul li { position: relative; padding-left: 20px; font-size: .94rem; color: var(--label-2); }
  .lp-sol ul li::before { content: ""; position: absolute; left: 0; top: 8px; width: 9px; height: 5px; border-left: 1.5px solid var(--amber); border-bottom: 1.5px solid var(--amber); transform: rotate(-45deg); }
  .lp-sol-cta { margin: auto 0 0; width: 100%; justify-content: center; min-height: 50px; }

  /* Franja de datos. Campo ámbar plano con tinta --on-brand (9,68:1). Sin tarjetas: los datos se
     separan con una línea, que es lo que pide una franja editorial compacta. */
  .lp-data { padding-block: clamp(48px, 6vw, 80px); background: var(--brand); color: var(--on-brand); }
  .lp-data h2 { max-width: 22ch; margin-bottom: clamp(26px, 3.5vw, 40px); }
  .lp-data-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(22px, 3vw, 44px); }
  /* El separador es una línea entre columnas, no un borde de tarjeta. */
  .lp-data-grid li + li { border-left: 1px solid rgba(35, 22, 0, .25); padding-left: clamp(22px, 3vw, 44px); }
  /* Tipografía fluida: el número manda sin romper la fila en pantallas intermedias. */
  .lp-data-n { margin: 0 0 12px; font-size: clamp(2.4rem, 4.6vw, 3.6rem); font-weight: 700; letter-spacing: -.05em; line-height: 1; }
  .lp-data-d { margin: 0 0 16px; font-size: 1rem; line-height: 1.55; color: rgba(35, 22, 0, .84); }
  .lp-data-src { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .lp-data-src a { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; min-height: 44px; font-size: .82rem; font-weight: 700; color: var(--on-brand); text-decoration: underline; text-underline-offset: 3px; }
  .lp-data-src a svg { width: 13px; height: 13px; flex: none; }
  .lp-data-src a:focus-visible { outline: 2px solid var(--on-brand); outline-offset: 3px; border-radius: 4px; }
  .lp-data-nota { font-size: .82rem; line-height: 1.45; color: rgba(35, 22, 0, .72); }
  .lp-data-foot { margin-top: clamp(30px, 4vw, 48px); padding-top: clamp(22px, 3vw, 32px); border-top: 1px solid rgba(35, 22, 0, .25); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; }
  .lp-data-foot p { margin: 0; font-size: 1.02rem; font-weight: 600; line-height: 1.5; max-width: 52ch; }
  /* El botón invierte la franja: tinta oscura de fondo sobre el ámbar, 9,68:1 al revés. */
  .lp-data-cta { margin: 0; flex: none; min-height: 52px; background: var(--on-brand); color: var(--brand); border: 0; font-weight: 700; }
  .lp-data-cta:focus-visible { outline: 2px solid var(--on-brand); outline-offset: 3px; }

  /* Secciones de detalle: dos columnas equilibradas, mismo espacio para las tres. */
  .lp-deep { padding-block: clamp(60px, 8vw, 112px); border-top: 1px solid var(--line); }
  /* Tras la franja ámbar el borde dibujaría una línea sobre el color: sobra. */
  .lp-connect + .lp-deep { border-top: 0; }
  .lp-deep.is-alt { background: var(--bg-2); }
  /* `start` y no `center`: cuando una columna es más alta, centrar la otra la deja flotando en
     medio de un hueco. Anclada arriba, el aire queda al final y se lee como margen. */
  .lp-deep-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 68px); align-items: start; }
  /* Alterna el lado en escritorio. En móvil el media query lo devuelve al orden del documento,
     que ya es mensaje y después demostración. */
  .lp-deep.is-alt .lp-deep-copy { order: 2; }
  /* El servicio va DENTRO del encabezado, no como etiqueta encima: recorriendo los h2 se leen
     los tres servicios, y la pregunta sigue siendo el gancho. */
  .lp-deep-svc { color: var(--amber); }
  .lp-deep-copy h2 { margin-bottom: 18px; max-width: 24ch; }
  .lp-deep-d { margin: 0 0 24px; font-size: 1.02rem; color: var(--label-2); line-height: 1.65; max-width: 46ch; }
  .lp-benes { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 14px; max-width: 46ch; }
  .lp-benes li { position: relative; padding-left: 28px; font-size: .98rem; color: var(--label-2); line-height: 1.5; }
  .lp-benes strong { display: block; color: var(--label); }
  .lp-benes li::before { content: ""; position: absolute; left: 0; top: 7px; width: 12px; height: 7px; border-left: 2px solid var(--amber); border-bottom: 2px solid var(--amber); transform: rotate(-45deg); }
  .lp-deep .btn { margin: 0; min-height: 54px; }
  .lp-deep .lp-note + .btn { margin-top: 22px; }

  /* Demostraciones. Dos piezas que llenan la columna: nada de media sección vacía. */
  .lp-demo { display: grid; gap: 18px; }
  /* El componente viene dimensionado para el hero de una página de servicio, donde se sale del
     margen a propósito. Aquí vive dentro de una columna: se le quita el desborde. */
  .lp-dv :global(.dv) { width: 100%; margin-right: 0; }
  .lp-demo.is-single { align-content: center; }
  /* Sin caja propia: las piezas de adentro (ficha, arbol, recorrido, logotipos) ya tienen su
     contorno, y envolverlas en otra tarjeta las dejaba anidadas una dentro de otra. */
  .lp-demo-frame, .lp-demo-aside { display: grid; align-content: start; }
  .lp-demo-aside { gap: 0; }
  .lp-demo-h { margin: 0 0 14px; font-size: .78rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--label-3); }
  .lp-demo-h.is-second { margin-top: 30px; }
  .lp-surf + .lp-surf { margin-top: 20px; }
  .lp-demo-cap { margin: 16px 0 0; font-size: .78rem; line-height: 1.45; color: var(--label-3); }

  .lp-pro { display: grid; grid-template-columns: auto 1fr; gap: 0 16px; align-items: center; background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 26px 24px; }
  .lp-pro-av { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--fill); color: var(--label-3); }
  .lp-pro-av svg { width: 30px; height: 30px; }
  .lp-pro-n { margin: 0; font-size: var(--s-1); font-weight: 600; letter-spacing: -.03em; }
  .lp-pro-e { margin: 3px 0 0; color: var(--amber); font-weight: 700; font-size: .9rem; }
  .lp-pro-meta { grid-column: 1 / -1; margin: 22px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 11px; }
  .lp-pro-meta > div { display: flex; gap: 12px; justify-content: space-between; align-items: baseline; }
  .lp-pro-meta dt { font-size: .84rem; color: var(--label-3); flex: none; }
  .lp-pro-meta dd { margin: 0; font-size: .92rem; font-weight: 600; text-align: right; }
  .lp-pro-btn { display: block; text-align: center; padding: 13px; border-radius: var(--r-sm); background: var(--brand); color: var(--on-brand); font-weight: 700; font-size: .92rem; }
  .lp-pro .lp-pro-btn { grid-column: 1 / -1; margin-top: 20px; }

  /* Los dos puntos de partida van lado a lado: apilados estiraban la columna y abrían un hueco
     frente al mensaje. */
  .lp-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lp-paths span { display: block; padding: 14px 16px; border: 1px solid var(--line-2); border-radius: var(--r-sm); font-size: .9rem; color: var(--label-3); line-height: 1.45; }
  .lp-paths strong { display: block; margin-bottom: 3px; font-size: .96rem; color: var(--label); }

  .lp-agenda-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .lp-agenda-row li { display: flex; align-items: center; justify-content: center; flex: 1 1 110px; min-height: 56px; padding: 0 16px; border: 1px solid var(--line-2); border-radius: var(--r-sm); }
  /* Los tres archivos son blancos sobre transparente, pensados para fondo oscuro: en tema claro
     se invierten a negro, igual que la cinta de clientes del inicio. Sin esto no se ven. */
  .lp-agenda-row img { width: 100%; max-width: 96px; height: auto; display: block; }
  :global(:root:not([data-theme="dark"])) .lp-agenda-row img { filter: grayscale(1) brightness(0); }
  .lp-agenda-row .is-more { border-style: dashed; }
  .lp-agenda-row .is-more span { color: var(--label-3); font-size: .86rem; }




  /* Franja de estrategia. También ámbar, pero en degradado y mucho más compacta que la de datos:
     son dos momentos distintos y quedan separados por las tres secciones de detalle. */
  .lp-connect { padding-block: clamp(48px, 6vw, 84px); background: linear-gradient(135deg, var(--brand) 0%, #F29F00 100%); color: var(--on-brand); }
  .lp-sub-on { color: rgba(35, 22, 0, .82); }
  /* Bento de cuatro soluciones. Arriba, dónde llega la persona (el sitio ocupa más porque es
     el servicio mayor); abajo, cómo llega, las dos en partes iguales. */
  /* Diez columnas para poder dar proporciones distintas a cada fila: 60/40 arriba y 50/50
     abajo. Con dos columnas fijas las dos filas habrían quedado iguales. */
  .lp-bento { display: grid; grid-template-columns: repeat(10, 1fr); gap: clamp(14px, 1.6vw, 20px); }
  .lp-bt:nth-child(1) { grid-column: span 6; }
  .lp-bt:nth-child(2) { grid-column: span 4; }
  .lp-bt:nth-child(3), .lp-bt:nth-child(4) { grid-column: span 5; }
  .lp-bt { display: flex; flex-direction: column; gap: 18px; background: rgba(255, 255, 255, .42); border: 1px solid rgba(35, 22, 0, .16); border-radius: var(--r-lg); padding: clamp(22px, 2.4vw, 30px); }
  .lp-bt-txt { display: grid; gap: 7px; }
  .lp-bt h3 { margin: 0; font-size: 1.22rem; letter-spacing: -.03em; line-height: 1.25; }
  .lp-bt-txt p:last-child { margin: 0; font-size: .97rem; line-height: 1.58; color: rgba(35, 22, 0, .78); max-width: 46ch; }
  /* El nombre del servicio abre el párrafo en negrita en vez de ir como etiqueta sobre el
     título: el encabezado ya es lo primero que se lee y no necesita un rótulo encima. */
  .lp-bt-txt strong { color: var(--on-brand); font-weight: 700; }
  .lp-bt-art { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }

  /* Las miniaturas: superficie casi blanca, trazo oscuro. Son ejemplos de lo que recibe el
     centro, no capturas: todo es forma salvo las etiquetas que nombran la pieza. */
  .lp-mini { background: rgba(255, 255, 255, .8); border: 1px solid rgba(35, 22, 0, .16); border-radius: var(--r-md); padding: 12px 14px; display: grid; gap: 9px; }
  .lp-mini.is-plain { background: rgba(255, 255, 255, .8); }
  .lp-mini.is-ad { padding: 10px 14px; }
  .lp-mini-top { display: flex; align-items: center; gap: 7px; padding-bottom: 10px; border-bottom: 1px solid rgba(35, 22, 0, .12); }
  .lp-mini-dot { width: 16px; height: 16px; border-radius: 50%; background: rgba(35, 22, 0, .22); flex: none; }
  .lp-mini-top i { height: 5px; border-radius: 3px; background: rgba(35, 22, 0, .16); flex: 1; }
  .lp-mini-body { display: grid; gap: 9px; justify-items: start; }
  .lp-mini-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .lp-mini-chips b { padding: 4px 9px; border: 1px solid rgba(35, 22, 0, .24); border-radius: 999px; font-size: .68rem; font-weight: 700; color: rgba(35, 22, 0, .78); }
  .lp-mini-line { display: block; height: 6px; border-radius: 3px; background: rgba(35, 22, 0, .16); }
  .lp-mini-line.is-acc { background: rgba(35, 22, 0, .42); }
  .lp-mini-line.is-w45 { width: 45%; } .lp-mini-line.is-w60 { width: 60%; } .lp-mini-line.is-w70 { width: 70%; }
  .lp-mini-line.is-w75 { width: 75%; } .lp-mini-line.is-w85 { width: 85%; } .lp-mini-line.is-w90 { width: 90%; }
  .lp-mini-cta { padding: 7px 14px; border-radius: 999px; background: var(--on-brand); color: var(--brand); font-size: .72rem; font-weight: 700; }
  .lp-mini-tag { justify-self: start; padding: 3px 8px; border: 1px solid rgba(35, 22, 0, .3); border-radius: 5px; font-size: .64rem; font-weight: 700; letter-spacing: .03em; color: rgba(35, 22, 0, .7); }
  .lp-mini-arrow { display: grid; place-items: center; color: rgba(35, 22, 0, .45); }
  .lp-mini-arrow svg { width: 17px; height: 17px; }
  .lp-mini-search { display: flex; align-items: center; gap: 9px; padding: 7px 11px; border: 1px solid rgba(35, 22, 0, .2); border-radius: 999px; color: rgba(35, 22, 0, .55); }
  .lp-mini-search svg { width: 14px; height: 14px; flex: none; }
  .lp-mini-search i { height: 5px; border-radius: 3px; background: rgba(35, 22, 0, .16); flex: 1; }
  .lp-mini-res { display: grid; gap: 7px; justify-items: start; padding-left: 2px; }
  .lp-mini-url { width: 38%; height: 5px; border-radius: 3px; background: rgba(35, 22, 0, .2); }

  .lp-bento-foot { margin-top: clamp(26px, 3vw, 36px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; }
  .lp-bento-foot p { margin: 0; font-size: 1.02rem; font-weight: 600; line-height: 1.5; max-width: 50ch; }


  /* Proyectos: la captura manda, el texto acompaña. */
  .lp-cases-sec { padding-block: clamp(60px, 8vw, 112px); }
  .lp-cases { display: grid; gap: clamp(20px, 3vw, 32px); }
  .lp-case { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 3vw, 40px); align-items: center; background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: clamp(22px, 2.5vw, 32px); transition: border-color .35s; }
  .lp-case:hover { border-color: var(--amber); }
  .lp-case:nth-child(even) .lp-case-shot { order: 2; }
  .lp-case-shot { margin: 0; overflow: hidden; border: 1px solid var(--line-2); border-radius: var(--r-md); background: var(--bg-2); box-shadow: var(--sh-2); }
  /* Barra del navegador: tres puntos y el dominio real. Sitúa la captura como un sitio en vivo
     sin inventar nada: la dirección es la misma a la que lleva el enlace de abajo. */
  .lp-case-bar { display: flex; align-items: center; gap: 12px; padding: 9px 12px; background: var(--card); border-bottom: 1px solid var(--line-2); }
  .lp-case-dots { display: flex; gap: 5px; flex: none; }
  .lp-case-dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); }
  .lp-case-url { flex: 1; min-width: 0; padding: 4px 12px; border-radius: 999px; background: var(--bg-2); font-size: .72rem; color: var(--label-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* `container-type: size` deja medir el alto del recuadro desde dentro: el recorrido termina
     justo con el pie de la página alineado abajo, y vale para capturas de distinto largo sin
     calcular nada a mano. */
  .lp-case-view { position: relative; aspect-ratio: 16 / 10; overflow: hidden; container-type: size; }
  .lp-case-page { position: absolute; top: 0; left: 0; width: 100%; height: auto; display: block; }
  .lp-case.is-browsing .lp-case-page { animation: lp-browse 42s ease-in-out infinite; }
  /* La segunda entra desfasada: en sincronia las dos capturas parecian un solo mecanismo. */
  .lp-case:nth-child(even) .lp-case-page { animation-delay: -13s; }
  /* Al pasar el puntero se congela: si algo llamó la atención, tiene que poder mirarse. */
  .lp-case:hover .lp-case-page, .lp-case:focus-within .lp-case-page { animation-play-state: paused; }
  @keyframes lp-browse {
    0%, 6% { transform: translateY(0); }
    52%, 60% { transform: translateY(calc(-100% + 100cqh)); }
    100% { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-case.is-browsing .lp-case-page { animation: none; }
  }
  .lp-case h3 { margin: 0 0 4px; font-size: var(--s-2); letter-spacing: -.035em; }
  .lp-case-sector { margin: 0 0 16px; font-size: .9rem; color: var(--label-3); }
  .lp-case-text { margin: 0 0 18px; font-size: 1rem; color: var(--label-2); line-height: 1.6; max-width: 44ch; }
  .lp-case-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-case-tags li { padding: 6px 12px; border: 1px solid var(--amber); border-radius: 999px; font-size: .8rem; font-weight: 700; color: var(--amber); }
  .lp-case-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; min-height: 44px; font-size: .94rem; font-weight: 700; color: var(--label); text-decoration: none; border-bottom: 1px solid var(--amber); }
  .lp-case-link svg { width: 15px; height: 15px; flex: none; transition: transform .25s var(--ease); }
  .lp-case-link:hover svg, .lp-case-link:focus-visible svg { transform: translate(2px, -2px); }
  .lp-case-link:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 6px; }

  /* Cinta de clientes */
  /* Va justo bajo el hero: es un golpe de credibilidad, no una sección. Por eso es baja. */
  .lp-logos { padding-block: clamp(28px, 3.5vw, 44px) clamp(32px, 4vw, 52px); border-top: 1px solid var(--line); overflow: hidden; }
  .lp-logos-h { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--label-3); max-width: none; margin: 0 0 clamp(20px, 2.5vw, 28px); }
  /* La máscara difumina los bordes para que los logotipos no se corten en seco. */
  .lp-marquee { display: flex; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .lp-track { list-style: none; margin: 0; padding: 0 clamp(32px, 5vw, 64px) 0 0; display: flex; flex: none; align-items: center; gap: clamp(32px, 5vw, 64px); animation: lp-slide 34s linear infinite; }
  .lp-marquee:hover .lp-track, .lp-marquee:focus-within .lp-track { animation-play-state: paused; }
  @keyframes lp-slide { to { transform: translateX(-100%); } }
  .lp-track li { flex: none; }
  /* Los archivos traen aire propio en el lienzo: a 38px la marca real quedaba diminuta. */
  .lp-track img { display: block; width: auto; height: 58px; opacity: .85; transition: opacity .3s; }
  .lp-track li:hover img { opacity: 1; }
  /* Los archivos son blancos sobre transparente, pensados para fondo oscuro: en tema claro se
     invierten a negro, igual que la cinta del inicio. Sin esto no se ven. */
  :global(:root:not([data-theme="dark"])) .lp-track img { filter: grayscale(1) brightness(0); }
  :global(:root[data-theme="dark"]) .lp-track img { filter: grayscale(1) brightness(0) invert(1); }

  /* Testimonios. El componente ya es una <section> y hereda el padding global del sitio: aqui
     solo va la franja y los ajustes que le dan mas peso en esta pagina. Envolverlo en otra
     <section> con su propio padding duplicaba el aire y dejaba la franja con el doble de alto
     que su contenido.

     En esta landing la prueba social es el argumento que cierra: la seccion pasa a tener
     superficie propia, las tarjetas se levantan del fondo y la nota de Google deja de ser una
     linea de 13px para convertirse en el dato que se ve primero. Todo va acotado a .lp-tst
     para no tocar el inicio, que usa el mismo componente. */
  .lp-tst { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  /* Las tarjetas eran contorno sobre el mismo fondo: contra una superficie alterna no se leian
     como piezas. Con superficie propia y sombra suave quedan por delante de la franja. */
  .lp-tst :global(.tst-card) { background: var(--card); box-shadow: var(--sh-2); border-color: var(--line); }
  .lp-tst :global(.tst-card:hover) { box-shadow: var(--sh-3); border-color: color-mix(in srgb, var(--amber) 55%, transparent); }
  .lp-tst :global(.tst-card blockquote) { font-size: .98rem; line-height: 1.6; }

  /* 4,4 de 5 con 18 resenas es el dato mas duro de esta seccion y estaba al tamano de un pie de
     foto. Pasa a bloque con contorno ambar, del tamano de un boton, y sigue llevando al listado
     real de Google. */
  .lp-tst :global(.tst-rating) {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 12px;
    margin-top: 26px; padding: 12px 18px; min-height: 56px;
    border: 1px solid color-mix(in srgb, var(--amber) 45%, transparent); border-radius: var(--r-lg);
    background: var(--card); font-size: .9rem;
    transition: border-color .3s, box-shadow .3s;
  }
  .lp-tst :global(.tst-rating:hover) { border-color: var(--amber); box-shadow: var(--sh-2); }
  .lp-tst :global(.tst-rating b) { font-size: 2rem; line-height: 1; }
  .lp-tst :global(.tst-stars) { font-size: 1.05rem; }

  .lp-tst :global(.tst-nav) { margin-top: 24px; }

  @media (max-width: 640px) {
    .lp-tst :global(.tst-rating) { width: 100%; justify-content: center; }
  }

  /* Preguntas frecuentes */
  .lp-faq { padding-block: clamp(60px, 8vw, 112px); background: var(--bg-2); border-top: 1px solid var(--line); }
  .lp-list { border-top: 1px solid var(--line-2); }
  .lp-row { border-bottom: 1px solid var(--line-2); }
  .lp-row summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 2px; cursor: pointer; font-size: var(--s-1); font-weight: 600; letter-spacing: -.02em; list-style: none; min-height: 44px; }
  .lp-row summary::-webkit-details-marker { display: none; }
  .lp-row summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; border-radius: 6px; }
  .lp-row summary span:first-child { transition: color .25s; }
  .lp-row summary:hover span:first-child { color: var(--amber); }
  .lp-chev { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line-2); color: var(--label-2); display: grid; place-items: center; transition: transform .3s var(--ease), border-color .3s; }
  .lp-chev svg { width: 15px; height: 15px; }
  .lp-row[open] .lp-chev { transform: rotate(180deg); border-color: var(--amber); color: var(--amber); }
  .lp-row p { margin: 0 0 22px; padding-right: 50px; font-size: 1rem; color: var(--label-2); line-height: 1.6; max-width: 72ch; }
  .lp-row[open] p { animation: lp-open .4s var(--ease); }
  @keyframes lp-open { from { opacity: 0; transform: translateY(-6px); } }

  /* Ley 21.719. Panel oscuro fijo en los dos temas: es una pausa de tono, no un servicio mas.
     Sin sellos ni insignias, que parecerian una certificacion que nadie otorgo. */
  .lp-ley { padding-block: clamp(44px, 6vw, 72px); }
  .lp-ley-in { background: #1A1A18; color: #F3F0E9; border: 1px solid rgba(243, 240, 233, .14); border-radius: var(--r-lg); padding: clamp(28px, 4vw, 48px); display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: start; max-width: 1180px; }
  .lp-ley-tag { display: flex; align-items: center; gap: 10px; margin: 16px 0 18px; font-size: .78rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--brand); }
  .lp-ley-ico { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; border: 1px solid rgba(255, 176, 32, .45); }
  .lp-ley-ico svg { width: 17px; height: 17px; }
  .lp-ley-copy h2 { margin: 0; max-width: 18ch; color: #F3F0E9; }
  .lp-ley-d { margin: 0 0 26px; font-size: 1.02rem; line-height: 1.65; color: rgba(243, 240, 233, .78); max-width: 46ch; }
  .lp-ley-copy .btn { margin: 0; min-height: 52px; }

  .lp-ley-h3 { margin: 0 0 14px; font-size: .78rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: rgba(243, 240, 233, .55); }
  .lp-ley-lista ul { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 12px; }
  .lp-ley-lista li { position: relative; padding-left: 28px; font-size: .98rem; line-height: 1.5; color: rgba(243, 240, 233, .9); }
  .lp-ley-lista li::before { content: ""; position: absolute; left: 0; top: 7px; width: 12px; height: 7px; border-left: 2px solid var(--brand); border-bottom: 2px solid var(--brand); transform: rotate(-45deg); }
  .lp-ley-nota { margin: 0; padding-top: 18px; border-top: 1px solid rgba(243, 240, 233, .16); font-size: .85rem; line-height: 1.55; color: rgba(243, 240, 233, .62); }
  .lp-ley-fecha { margin: 14px 0 0; font-size: .85rem; line-height: 1.55; color: rgba(243, 240, 233, .62); }
  .lp-ley-fecha a { display: inline-flex; align-items: center; gap: 6px; margin-left: 4px; min-height: 44px; color: var(--brand); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .lp-ley-fecha a svg { width: 12px; height: 12px; flex: none; }
  .lp-ley-fecha a:focus-visible, .lp-ley-copy .btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }

  /* Cierre: formulario liviano. Los servicios se eligen primero, que es la pregunta real. */
  .lp-form-sec { padding-block: clamp(60px, 8vw, 104px); }
  .lp-form-in { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 5vw, 56px); align-items: start; }
  .lp-form-side h2 { max-width: 14ch; }
  .lp-form-alt { margin: 22px 0 0; color: var(--label-3); }
  .lp-form-alt a { color: var(--amber); font-weight: 700; text-decoration: none; }

  .lp-form-card { background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 30px 28px 24px; }
  .lp-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .lp-form-card .field { margin-bottom: 14px; }
  .lp-form-card .field label span { font-weight: 400; color: var(--label-3); }
  .lp-form-card .field input, .lp-form-card .field textarea { width: 100%; caret-color: var(--amber); }
  /* El borde de tema claro del sistema (#CEC6BA sobre --card) da 1,57:1 y desaparece. Aquí el
     formulario no es un paso del embudo, es el embudo, así que usa un token con 5,3:1. */
  :global(:root:not([data-theme="dark"])) .lp-form-card .field input,
  :global(:root:not([data-theme="dark"])) .lp-form-card .field textarea { border-color: var(--label-3); }

  .lp-need { border: 0; padding: 0; margin: 0 0 22px; }
  .lp-need legend { font-size: var(--s--1); font-weight: 600; color: var(--label-2); margin-bottom: 10px; padding: 0; }
  /* En fila: cuatro opciones cortas ocupan menos y se recorren de un vistazo. */
  .lp-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-chip { cursor: pointer; }
  .lp-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .lp-chip span { display: flex; align-items: center; min-height: 44px; padding: 10px 16px; border: 1px solid var(--line-2); border-radius: 999px; font-size: .92rem; font-weight: 600; color: var(--label-2); transition: border-color .2s, background-color .2s, color .2s; }
  .lp-chip input:checked + span { border-color: var(--amber); background: var(--fill); color: var(--label); }
  .lp-chip input:focus-visible + span { outline: 2px solid var(--amber); outline-offset: 2px; }

  .lp-go { width: 100%; justify-content: center; margin-top: 6px; border: 0; cursor: pointer; font: inherit; font-weight: 700; min-height: 54px; }
  .lp-go[disabled] { opacity: .6; cursor: default; }
  .lp-status:empty { display: none; }
  /* Éxito y error no comparten color: en ámbar los dos, un envío fallido parecía logrado. */
  .lp-status { margin: 14px 0 0; padding: 12px 14px; border-radius: var(--r-sm); font-size: var(--s--1); line-height: 1.5; border: 1px solid var(--line-2); color: var(--label-2); }
  .lp-status.is-ok { border-color: #1E7A44; color: #166534; background: rgba(30, 122, 68, .08); }
  .lp-status.is-err { border-color: #B42318; color: #B42318; background: rgba(180, 35, 24, .07); }
  :global(:root[data-theme="dark"]) .lp-status.is-ok { color: #6EE7A0; border-color: #2F7D52; }
  :global(:root[data-theme="dark"]) .lp-status.is-err { color: #FCA5A5; border-color: #9B3B33; }
  .lp-legal { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: .79rem; line-height: 1.45; color: var(--label-3); }
  .lp-legal a { color: var(--label-2); }
  .lp-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .lp-foot { padding-block: 28px; border-top: 1px solid var(--line); }
  .lp-foot p { margin: 0; font-size: .79rem; color: var(--label-3); }

  /* Barra fija: solo en móvil, donde el CTA del encabezado se esconde en el menú. Entra cuando
     el botón del hero ya salió de pantalla, para no repetir la misma acción dos veces. */
  .lp-sticky { display: none; transform: translateY(120%); transition: transform .28s var(--ease); position: fixed; left: 0; right: 0; bottom: 0; z-index: 35; padding: 10px clamp(16px, 4vw, 40px); background: var(--glass-bar); border-top: 1px solid var(--line-2); backdrop-filter: saturate(160%) blur(12px); }
  .lp-sticky .btn { width: 100%; justify-content: center; min-height: 50px; margin: 0; }

  /* Movimiento. Todo parte de un estado VISIBLE y la animación solo lo mejora: si el script no
     corre, no hay IntersectionObserver o la persona pidió menos movimiento, la página se ve
     completa igual. Nunca se oculta contenido a la espera de JavaScript. */
  :global(html.wf-reveal) [data-reveal] { opacity: 0; transform: translateY(18px); }
  :global(html.wf-reveal) [data-reveal].is-in { opacity: 1; transform: none; transition: opacity .7s var(--ease), transform .7s var(--ease); }
  /* Las piezas hermanas entran escalonadas, no todas de golpe. */
  :global(html.wf-reveal) .lp-sol:nth-child(2), :global(html.wf-reveal) .lp-data-grid li:nth-child(2) { transition-delay: .09s; }
  :global(html.wf-reveal) .lp-sol:nth-child(3), :global(html.wf-reveal) .lp-data-grid li:nth-child(3) { transition-delay: .18s; }
  :global(html.wf-reveal) .lp-case:nth-child(2) { transition-delay: .09s; }

  @media (max-width: 1040px) {
    .lp-sol-grid { grid-template-columns: 1fr; }
    .lp-sol-cta { width: auto; align-self: flex-start; }
    /* El orden del documento ya es mensaje y después demostración: basta con soltar el order. */
    .lp-deep-in, .lp-form-in { grid-template-columns: 1fr; align-items: start; }
    .lp-deep.is-alt .lp-deep-copy { order: 0; }
    .lp-deep-d, .lp-benes, .lp-case-text { max-width: 62ch; }
    .lp-case { grid-template-columns: 1fr; }
    .lp-case:nth-child(even) .lp-case-shot { order: 0; }
  }

  @media (max-width: 920px) {
    /* La barra fija de abajo mide unos 71px: el flotante y el "volver arriba" suben por encima
       para no quedar debajo de ella ni tapar su botón. */
    /* Con :global(.wa-float) a secas quedaba empatado en especificidad con la regla de 640px de
       global.css y perdia por orden. Con body delante gana por un punto. */
    :global(body .wa-float) { bottom: 86px; }
    :global(body .totop) { bottom: 152px; }
    .lp-nav, .lp-head-cta { display: none; }
    .lp-menu { display: block; }
    /* Apilada ocupa el ancho completo de la pantalla y solo se desvanece por abajo: el
       degradado lateral, pensado para separarla del texto, aquí se comía media foto. */
    /* En vertical no hay sitio para que el texto ocupe un costado: el velo pasa a ser vertical
       y la foto queda detrás, con el encuadre corrido hacia las dos personas. */
    /* En vertical la foto deja de ser fondo y pasa a ser una banda propia arriba, de ancho
       completo. Poner el texto encima obligaba a oscurecerla tanto que no se veía nada: así la
       escena se ve limpia y el texto se lee sobre el fondo de la página, sin pelear. */
    .lp-hero { min-height: 0; align-items: start; padding-top: 0; row-gap: clamp(22px, 5vw, 32px); }
    .lp-hero-copy { max-width: none; }
    .lp-hero-bg { position: relative; inset: auto; z-index: 0; height: clamp(280px, 46vh, 400px); }
    .lp-hero-bg img { object-position: center 28%; }
    .lp-hero-bg::after {
      background: linear-gradient(0deg, var(--bg) 1%, color-mix(in srgb, var(--bg) 55%, transparent) 16%, transparent 38%);
    }
    .lp-hero-copy h1 { font-size: var(--s-2); }
    /* El salto de línea del titular es para escritorio; en móvil estorba. */
    .lp-hero-copy h1 br { display: none; }
    .lp-hero-ctas .btn { flex: 1 1 200px; justify-content: center; }
    /* Los datos se apilan con separadores horizontales, sin carrusel. */
    .lp-data-grid { grid-template-columns: 1fr; gap: 0; }
    .lp-data-grid li + li { border-left: 0; padding-left: 0; border-top: 1px solid rgba(35, 22, 0, .25); margin-top: 26px; padding-top: 26px; }
    .lp-data-foot { flex-direction: column; align-items: flex-start; }
    .lp-data-cta { width: 100%; justify-content: center; }
    .lp-ley-in { grid-template-columns: 1fr; }
    .lp-bento { grid-template-columns: 1fr; }
    .lp-bt { grid-column: 1 / -1; }
    .lp-bento-foot { flex-direction: column; align-items: flex-start; }
    .lp-bento-foot .lp-data-cta { width: 100%; justify-content: center; }
    /* En vertical la llave se vuelve una línea corta entre las entradas y el destino. */
    .lp-sticky { display: block; }
    .lp-sticky.is-on { transform: none; }

    /* Teléfono y correo dejan de ser texto subrayado de 19px y pasan a botones de 54px: en este
       sitio los accesos de contacto se ampliaron a propósito tras el análisis de Clarity, y en
       el celular una línea de texto es justo lo que nadie acierta. */
    .lp-form-alt { display: grid; gap: 10px; }
    .lp-alt-o { display: none; }
    .lp-alt-q { margin-bottom: 2px; }
    .lp-form-alt a { display: flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 18px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--label); }
    .lp-form-alt a:first-of-type { border-color: var(--amber); color: var(--amber); }
    .lp-foot { padding-bottom: 96px; }
  }

  @media (max-width: 560px) {
    .lp-grid2 { grid-template-columns: 1fr; }
    .lp-form-card, .lp-demo-frame, .lp-demo-aside { padding: 22px 18px; }
    .lp-paths { grid-template-columns: 1fr; }
    .lp-sol { padding: 26px 22px 24px; }
    .lp-sol-art { height: 62px; margin-bottom: 16px; }
    .lp-sol-art :global(.lp-art) { width: 72px; }
    .lp-pro-meta > div { flex-direction: column; gap: 2px; }
    .lp-pro-meta dd { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .lp-chev, .lp-nav a, .lp-chip span, .lp-case-link svg, .lp-sticky,
    .lp-sol, .lp-case, .lp-row summary span:first-child { transition: none; }
    .lp-sol:hover { transform: none; }
    .lp-row[open] p { animation: none; }
    /* Sin movimiento la cinta se vuelve una fila fija y centrada, y la copia sobra. */
    .lp-marquee { -webkit-mask-image: none; mask-image: none; justify-content: center; }
    .lp-track { animation: none; flex-wrap: wrap; justify-content: center; padding-right: 0; row-gap: 28px; }
    .lp-track[aria-hidden] { display: none; }
  }
</style>

<script define:vars={{ ayudas }}>
  /* Preselección: al pulsar "Cotizar Google Ads" en cualquier tarjeta, el formulario de abajo
     llega con esa casilla ya marcada, SIN borrar lo que la persona haya escrito. El CTA de la
     franja de datos no lleva data-need a propósito: ahí no se pide un servicio en particular.
     Sin JavaScript el ancla igual baja al formulario y la persona elige a mano. */
  /* El recorrido de las capturas solo corre mientras el bloque esta en pantalla: una animacion
     de 30 s pintando fuera de vista gasta bateria sin que nadie la vea. */
  (function () {
    var casos = document.querySelectorAll('.lp-case');
    if (!casos.length) return;
    if (!('IntersectionObserver' in window)) {
      casos.forEach(function (c) { c.classList.add('is-browsing'); });
      return;
    }
    var ojo = new IntersectionObserver(function (ents) {
      ents.forEach(function (e) { e.target.classList.toggle('is-browsing', e.isIntersecting); });
    }, { rootMargin: '120px' });
    casos.forEach(function (c) { ojo.observe(c); });
  })();

  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-need]');
      if (!a) return;
      var c = document.querySelector('input[name="ayuda"][value="' + a.getAttribute('data-need') + '"]');
      if (c) c.checked = true;
    });
  })();

  /* Panel lateral. <details> deja de renderizar sus hijos apenas se le quita el atributo `open`,
     asi que el cierre pasa por una clase intermedia: se anima la salida y recien despues se
     cierra de verdad. Con movimiento reducido no hay espera. */
  (function () {
    var menu = document.querySelector('.lp-menu');
    if (!menu) return;
    var boton = menu.querySelector('summary');
    var cerrar = menu.querySelector('.lp-menu-x');
    var velo = menu.querySelector('.lp-menu-bg');
    var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saliendo = null;

    function abierto() { return menu.hasAttribute('open'); }

    /* Bloquear el scroll quita la barra del navegador y la pagina salta esos pixeles hacia la
       derecha. Se compensan con un relleno del mismo ancho. En un celular la barra no ocupa
       espacio, asi que ahi el calculo da cero y no hace nada. */
    function bloquear(si) {
      var raiz = document.documentElement;
      raiz.classList.toggle('wf-menu', si);
      if (si) {
        var barra = window.innerWidth - raiz.clientWidth;
        if (barra > 0) raiz.style.paddingRight = barra + 'px';
        raiz.style.overflow = 'hidden';
      } else {
        raiz.style.overflow = '';
        raiz.style.paddingRight = '';
      }
    }

    function cerrarPanel(devolverFoco) {
      if (!abierto() || saliendo) return;
      menu.classList.add('is-closing');
      saliendo = setTimeout(function () {
        menu.removeAttribute('open');
        menu.classList.remove('is-closing');
        bloquear(false);
        saliendo = null;
        if (devolverFoco && boton) boton.focus();
      }, quieto ? 0 : 340);
    }

    /* El clic nativo del summary cerraria de golpe: se intercepta para que salga animado. */
    if (boton) {
      boton.addEventListener('click', function (e) {
        if (!abierto()) return;
        e.preventDefault();
        cerrarPanel(true);
      });
    }

    menu.addEventListener('toggle', function () {
      if (!abierto()) return;
      bloquear(true);
      if (cerrar) cerrar.focus();
    });

    if (cerrar) cerrar.addEventListener('click', function () { cerrarPanel(true); });
    if (velo) velo.addEventListener('click', function () { cerrarPanel(true); });

    /* Elegir una seccion cierra el panel; el ancla se encarga del resto. */
    menu.querySelectorAll('.lp-menu-panel a').forEach(function (a) {
      a.addEventListener('click', function () { cerrarPanel(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && abierto()) cerrarPanel(true);
    });

    /* El foco no debe escaparse a la pagina de atras mientras el panel esta abierto. */
    document.addEventListener('focusin', function (e) {
      if (!abierto() || saliendo) return;
      if (!menu.contains(e.target) && cerrar) cerrar.focus();
    });
  })();

  /* Aparición al entrar en pantalla. La clase wf-reveal se pone desde aquí: sin JavaScript
     nunca llega, y entonces las reglas del estilo no aplican y todo se ve desde el primer
     pintado. Se respeta prefers-reduced-motion consultándolo antes de armar nada. */
  (function () {
    var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (quieto || !('IntersectionObserver' in window)) return;
    var piezas = [].slice.call(document.querySelectorAll('[data-reveal]'));
    if (!piezas.length) return;
    document.documentElement.classList.add('wf-reveal');

    function mostrar(el) { el.classList.add('is-in'); }

    var obs = new IntersectionObserver(function (ents) {
      ents.forEach(function (en) {
        if (!en.isIntersecting) return;
        mostrar(en.target);
        obs.unobserve(en.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    piezas.forEach(function (el) { obs.observe(el); });

    /* Tres redes de seguridad, porque esconder contenido a la espera de JavaScript es justo lo
       que dejó texto invisible a usuarios reales en el sitio anterior:
         1. Lo que ya está en pantalla se muestra de inmediato, sin esperar al observador.
         2. Un barrido manual por si el observador no dispara (pasa al redimensionar o al
            capturar la página completa).
         3. A los 4 segundos se muestra todo lo pendiente, pase lo que pase. */
    function barrer() {
      var alto = window.innerHeight || 0;
      piezas.forEach(function (el) {
        if (el.classList.contains('is-in')) return;
        var r = el.getBoundingClientRect();
        if (r.top < alto && r.bottom > 0) { mostrar(el); obs.unobserve(el); }
      });
    }
    barrer();
    window.addEventListener('load', barrer);
    window.addEventListener('resize', barrer, { passive: true });
    setTimeout(function () {
      piezas.forEach(function (el) { mostrar(el); obs.unobserve(el); });
    }, 4000);
  })();

  /* La barra fija aparece cuando el CTA del hero deja de verse: mientras está a la vista, la
     barra repetiría el mismo botón. Sin JavaScript no aparece nunca, y el CTA del hero y el del
     final siguen ahí: la acción nunca depende de esto. */
  (function () {
    var bar = document.querySelector('.lp-sticky');
    var ancla = document.querySelector('.lp-hero-ctas');
    var destino = document.getElementById('cotizar');
    if (!bar || !ancla || !('IntersectionObserver' in window)) return;

    /* La barra sobra en dos momentos: cuando el boton del hero esta a la vista (repetiria la
       misma accion) y cuando el formulario ya esta en pantalla, donde ademas le tapaba 70px
       justo mientras la persona lo llena. */
    var heroVisible = true;
    var formVisible = false;
    function pintar() { bar.classList.toggle('is-on', !heroVisible && !formVisible); }

    new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; pintar(); }).observe(ancla);
    if (destino) {
      new IntersectionObserver(function (e) { formVisible = e[0].isIntersecting; pintar(); }, { threshold: 0.12 }).observe(destino);
    }
  })();

  /* Envío real contra /api/contacto.php, la misma ruta que usan el formulario de contacto y el
     del pie. No se simula nada: si el servidor responde error, se dice. */
  (function () {
    var form = document.getElementById('lpForm');
    if (!(form instanceof HTMLFormElement)) return;
    var nombreEl = document.getElementById('lpNombre');
    var mailEl = document.getElementById('lpMail');
    var status = document.getElementById('lpStatus');
    var boton = form.querySelector('button[type="submit"]');
    var t0 = Date.now();

    function decir(txt, clase) {
      status.className = 'lp-status ' + clase;
      status.textContent = txt;
    }
    function track(ev, params) { if (typeof window.wfTrack === 'function') window.wfTrack(ev, params); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      nombreEl.removeAttribute('aria-invalid');
      mailEl.removeAttribute('aria-invalid');

      var nombre = nombreEl.value.trim();
      if (!nombre) {
        decir('Falta tu nombre para poder responderte.', 'is-err');
        nombreEl.setAttribute('aria-invalid', 'true');
        nombreEl.focus();
        return;
      }
      var mail = mailEl.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail)) {
        decir('Revisa el correo: ahí es donde te enviamos la cotización.', 'is-err');
        mailEl.setAttribute('aria-invalid', 'true');
        mailEl.focus();
        return;
      }

      /* Selección múltiple. La primera marcada define el asunto del correo (lista cerrada
         INTERESES de contacto.php); todas las marcadas se detallan en el cuerpo. */
      var marcadas = [].slice.call(form.querySelectorAll('input[name="ayuda"]:checked'));
      var elegidas = marcadas.map(function (c) {
        return ayudas.filter(function (a) { return a.v === c.value; })[0];
      }).filter(Boolean);
      var principal = elegidas[0] || { interes: 'salud', t: 'Sin especificar' };

      var detalle = elegidas.length
        ? elegidas.map(function (a) { return '· ' + a.t; }).join('\n')
        : '· No indicó una línea en particular.';
      var libre = document.getElementById('lpMsg').value.trim();
      var cuerpo = 'Solicitud de cotización desde la landing de centros de salud (Google Ads).\n\n'
        + 'Qué necesita:\n' + detalle
        + (libre ? '\n\nObjetivo:\n' + libre : '');

      var datos = new FormData();
      datos.set('form', 'contacto');
      datos.set('nombre', nombre);
      datos.set('email', mail);
      datos.set('tel', document.getElementById('lpTel').value.trim());
      datos.set('empresa', document.getElementById('lpCentro').value.trim());
      datos.set('interes', principal.interes);
      datos.set('msg', cuerpo);
      datos.set('website', document.getElementById('lpWebsite').value);
      datos.set('pagina', document.title + ' (' + location.pathname + ')');
      datos.set('e', String(Date.now() - t0));

      boton.disabled = true;
      decir('Enviando…', '');

      /* Se exige el {"ok":true} que devuelve contacto.php, no solo un 200: así un 200 que no sea
         del script (por ejemplo el archivo servido tal cual) nunca pasa por envío logrado. */
      fetch('/api/contacto.php', { method: 'POST', body: datos, credentials: 'same-origin' })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (j) {
          if (!j || j.ok !== true) throw new Error(j && j.error ? j.error : 'desconocido');
          track('generate_lead', { form_kind: 'landing-salud' });
          track('wf_cta_continue', { interes: principal.interes, surface: 'landing-salud' });
          decir('Listo. Recibimos tu solicitud y te respondemos en menos de 24 horas hábiles.', 'is-ok');
          form.reset();
        })
        .catch(function (err) {
          var motivo = String(err && err.message);
          if (motivo === 'limit') {
            decir('Recibimos varias solicitudes desde esta conexión. Espera un momento o escríbenos al +56 9 3197 1436.', 'is-err');
          } else if (motivo === 'fast') {
            decir('El envío salió demasiado rápido. Inténtalo otra vez, por favor.', 'is-err');
          } else if (motivo === 'email') {
            decir('El correo no fue aceptado. Revísalo e inténtalo de nuevo.', 'is-err');
            mailEl.setAttribute('aria-invalid', 'true');
            mailEl.focus();
          } else {
            decir('No pudimos enviar el formulario. Escríbenos a contacto@webfriends.cl o al +56 9 3197 1436 y lo resolvemos.', 'is-err');
          }
        })
        .then(function () { boton.disabled = false; });
    });
  })();
</script>
