<!-- Movimiento de la composicion del hero. Va en un <script> SIN atributos para que Astro lo
     procese y pueda importar GSAP, que ya es dependencia del sitio (lo usan HeroBlobs, ArcScroll
     y LitSteps). El de mas arriba lleva define:vars, asi que Astro lo trata como inline y ahi un
     import no funcionaria. -->
<script>
  import { gsap } from 'gsap';

  const compo = document.querySelector('.lp-compo');
  const conMovimiento = matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (compo instanceof HTMLElement && conMovimiento) {
    const q = gsap.utils.selector(compo);
    const tarjetas = q('.lp-compo-card');

    /* Todo se anima con .from(): el estado final es el que ya esta en el HTML, asi que si GSAP
       no carga o algo falla, la composicion se ve completa igual. Nunca se deja una pieza
       escondida esperando a que el script la muestre. */
    const entrada = gsap.timeline({ delay: 0.35, defaults: { ease: 'power3.out' } });

    entrada
      // Las tres tarjetas llegan escalonadas, no de golpe.
      .from(tarjetas, { y: 26, opacity: 0, duration: 0.7, stagger: 0.12 })

      // SEO: los resultados se dibujan de izquierda a derecha, como una lista que carga.
      .from(q('.is-seo .lp-compo-res .lp-bar'), {
        scaleX: 0, transformOrigin: 'left center', opacity: 0, duration: 0.45, stagger: 0.09,
      }, '-=0.35')
      // El destello de IA gira al aparecer: es la pieza que distingue GEO de SEO.
      .from(q('.lp-compo-spark'), { scale: 0, rotate: -180, duration: 0.6, ease: 'back.out(2)' }, '-=0.1')
      .from(q('.is-seo .lp-compo-ia .lp-bar'), {
        scaleX: 0, transformOrigin: 'left center', opacity: 0, duration: 0.4, stagger: 0.09,
      }, '-=0.3')

      // Ads: primero la etiqueta "Anuncio", despues el texto del aviso.
      .from(q('.is-ads .lp-compo-pill'), { scale: 0.7, opacity: 0, duration: 0.4, ease: 'back.out(2)' }, '-=0.35')
      .from(q('.is-ads .lp-compo-ad .lp-bar'), {
        scaleX: 0, transformOrigin: 'left center', opacity: 0, duration: 0.4, stagger: 0.09,
      }, '-=0.2')

      // Web: la ficha se arma —foto, nombre, especialidad— y al final aparece el boton.
      .from(q('.lp-compo-av'), { scale: 0, duration: 0.5, ease: 'back.out(1.7)' }, '-=0.35')
      .from(q('.is-web .lp-compo-pro .lp-bar'), {
        scaleX: 0, transformOrigin: 'left center', opacity: 0, duration: 0.4, stagger: 0.09,
      }, '-=0.25')
      .from(q('.lp-compo-rows span'), { x: -14, opacity: 0, duration: 0.45, stagger: 0.1 }, '-=0.2')
      .from(q('.lp-compo-btn'), { y: 14, opacity: 0, duration: 0.5, ease: 'back.out(1.4)' }, '-=0.15');

    /* Movimiento de fondo, permanente y lento: la composicion respira en vez de quedarse quieta.
       Cada tarjeta flota con su propio ritmo para que no parezca un bloque.
       Solo a partir de 561px: en el celular las tres van en una fila estrecha y los desfases
       verticales las dejan desalineadas en vez de vivas. */
    gsap.matchMedia().add('(min-width: 561px)', () => {
      tarjetas.forEach((tarjeta, i) => {
        gsap.to(tarjeta, {
          y: i === 0 ? -9 : 9,
          duration: 3.4 + i * 0.5,
          delay: 1.6 + i * 0.25,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
        });
      });
    });

    // El destello de IA gira sin parar, muy despacio.
    gsap.to(q('.lp-compo-spark svg'), { rotate: 360, duration: 14, ease: 'none', repeat: -1, delay: 1.6 });

    // Cada tanto, el boton de reserva late: es la accion que la ficha propone.
    gsap.timeline({ repeat: -1, repeatDelay: 3.4, delay: 3 })
      .to(q('.lp-compo-btn'), { scale: 1.04, duration: 0.22, ease: 'power2.out' })
      .to(q('.lp-compo-btn'), { scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.45)' });

    /* Parallax con el puntero, solo en dispositivos con mouse. Usa `x` y deja `y` libre para que
       no choque con la flotacion de arriba. gsap.quickTo evita crear un tween por cada evento. */
    if (matchMedia('(pointer: fine)').matches) {
      const mueve = tarjetas.map((t, i) => ({
        x: gsap.quickTo(t, 'x', { duration: 0.8, ease: 'power3.out' }),
        rot: gsap.quickTo(t, 'rotate', { duration: 0.8, ease: 'power3.out' }),
        f: i === 0 ? 1 : -0.7,
      }));
      compo.addEventListener('pointermove', (e) => {
        const caja = compo.getBoundingClientRect();
        const dx = (e.clientX - caja.left) / caja.width - 0.5;
        mueve.forEach((m) => { m.x(dx * 16 * m.f); m.rot(dx * 1.2 * m.f); });
      });
      compo.addEventListener('pointerleave', () => {
        mueve.forEach((m) => { m.x(0); m.rot(0); });
      });
    }
  }

  /* La demostracion de SEO / GEO: primero cargan los resultados de busqueda, despues el destello
     "piensa" y la respuesta se escribe linea por linea con un cursor al final. Se repite en bucle
     para que quien llegue a mitad de la seccion igual la vea. */
  const seo = document.querySelector('#seo .lp-demo-aside');

  if (seo instanceof HTMLElement && conMovimiento) {
    const qs = gsap.utils.selector(seo);
    const lineas = qs('.lp-ia-linea');
    const cursores = qs('.lp-ia-cursor');

    const ciclo = gsap.timeline({ repeat: -1, repeatDelay: 2.6, paused: true });

    ciclo
      .set(cursores, { autoAlpha: 0 })
      // Los resultados de busqueda aparecen de izquierda a derecha.
      .from(qs('.lp-busca'), {
        scaleX: 0, transformOrigin: 'left center', opacity: 0, duration: 0.4, stagger: 0.13, ease: 'power2.out',
      })
      // El destello gira: el modelo esta resolviendo.
      .to(qs('.lp-ia-spark'), { rotate: '+=360', duration: 0.95, ease: 'power2.inOut' }, '-=0.1');

    // Cada linea se escribe con su cursor; al terminar, el cursor pasa a la siguiente.
    lineas.forEach((linea, i) => {
      const barra = linea.querySelector('.lp-bar');
      const cursor = cursores[i];
      ciclo
        .set(cursor, { autoAlpha: 1 }, '>-0.05')
        /* Se anima el ancho y no scaleX: la barra tiene que empujar al cursor, y una escala
           horizontal no mueve al elemento siguiente. clearProps devuelve el % del CSS, para que
           al redimensionar la ventana no quede un ancho en pixeles congelado. */
        .from(barra, { width: 0, duration: 0.55 + i * 0.1, ease: 'none', clearProps: 'width' })
        .set(cursor, { autoAlpha: 0 });
    });

    // El cursor parpadea mientras escribe, aparte del ciclo.
    gsap.to(cursores, { opacity: 0.15, duration: 0.5, repeat: -1, yoyo: true, ease: 'steps(1)' });

    /* Solo corre cuando la seccion esta a la vista: en una pagina larga no tiene sentido animar
       algo que nadie mira. */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((ents) => {
        ents[0].isIntersecting ? ciclo.play() : ciclo.pause();
      }, { threshold: 0.3 }).observe(seo);
    } else {
      ciclo.play();
    }
  }
</script>

<script define:vars={{ ayudas }}>
  /* Preselección: al pulsar "Cotizar Google Ads" en cualquier tarjeta, el formulario de abajo
     llega con esa casilla ya marcada, SIN borrar lo que la persona haya escrito. El CTA de la
     franja de datos no lleva data-need a propósito: ahí no se pide un servicio en particular.
     Sin JavaScript el ancla igual baja al formulario y la persona elige a mano. */
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-need]');
      if (!a) return;
      var c = document.querySelector('input[name="ayuda"][value="' + a.getAttribute('data-need') + '"]');
      if (c) c.checked = true;
    });
  })();

  /* Panel lateral. <details> deja de renderizar sus hijos apenas se le quita el atributo `open`,
     asi que el cierre pasa por una clase intermedia: se anima la salida y recien despues se
     cierra de verdad. Con movimiento reducido no hay espera. */
  (function () {
    var menu = document.querySelector('.lp-menu');
    if (!menu) return;
    var boton = menu.querySelector('summary');
    var cerrar = menu.querySelector('.lp-menu-x');
    var velo = menu.querySelector('.lp-menu-bg');
    var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saliendo = null;

    function abierto() { return menu.hasAttribute('open'); }

    /* Bloquear el scroll quita la barra del navegador y la pagina salta esos pixeles hacia la
       derecha. Se compensan con un relleno del mismo ancho. En un celular la barra no ocupa
       espacio, asi que ahi el calculo da cero y no hace nada. */
    function bloquear(si) {
      var raiz = document.documentElement;
      raiz.classList.toggle('wf-menu', si);
      if (si) {
        var barra = window.innerWidth - raiz.clientWidth;
        if (barra > 0) raiz.style.paddingRight = barra + 'px';
        raiz.style.overflow = 'hidden';
      } else {
        raiz.style.overflow = '';
        raiz.style.paddingRight = '';
      }
    }

    function cerrarPanel(devolverFoco) {
      if (!abierto() || saliendo) return;
      menu.classList.add('is-closing');
      saliendo = setTimeout(function () {
        menu.removeAttribute('open');
        menu.classList.remove('is-closing');
        bloquear(false);
        saliendo = null;
        if (devolverFoco && boton) boton.focus();
      }, quieto ? 0 : 340);
    }

    /* El clic nativo del summary cerraria de golpe: se intercepta para que salga animado. */
    if (boton) {
      boton.addEventListener('click', function (e) {
        if (!abierto()) return;
        e.preventDefault();
        cerrarPanel(true);
      });
    }

    menu.addEventListener('toggle', function () {
      if (!abierto()) return;
      bloquear(true);
      if (cerrar) cerrar.focus();
    });

    if (cerrar) cerrar.addEventListener('click', function () { cerrarPanel(true); });
    if (velo) velo.addEventListener('click', function () { cerrarPanel(true); });

    /* Elegir una seccion cierra el panel; el ancla se encarga del resto. */
    menu.querySelectorAll('.lp-menu-panel a').forEach(function (a) {
      a.addEventListener('click', function () { cerrarPanel(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && abierto()) cerrarPanel(true);
    });

    /* El foco no debe escaparse a la pagina de atras mientras el panel esta abierto. */
    document.addEventListener('focusin', function (e) {
      if (!abierto() || saliendo) return;
      if (!menu.contains(e.target) && cerrar) cerrar.focus();
    });
  })();

  /* Aparición al entrar en pantalla. La clase wf-reveal se pone desde aquí: sin JavaScript
     nunca llega, y entonces las reglas del estilo no aplican y todo se ve desde el primer
     pintado. Se respeta prefers-reduced-motion consultándolo antes de armar nada. */
  (function () {
    var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (quieto || !('IntersectionObserver' in window)) return;
    var piezas = [].slice.call(document.querySelectorAll('[data-reveal]'));
    if (!piezas.length) return;
    document.documentElement.classList.add('wf-reveal');

    function mostrar(el) { el.classList.add('is-in'); }

    var obs = new IntersectionObserver(function (ents) {
      ents.forEach(function (en) {
        if (!en.isIntersecting) return;
        mostrar(en.target);
        obs.unobserve(en.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    piezas.forEach(function (el) { obs.observe(el); });

    /* Tres redes de seguridad, porque esconder contenido a la espera de JavaScript es justo lo
       que dejó texto invisible a usuarios reales en el sitio anterior:
         1. Lo que ya está en pantalla se muestra de inmediato, sin esperar al observador.
         2. Un barrido manual por si el observador no dispara (pasa al redimensionar o al
            capturar la página completa).
         3. A los 4 segundos se muestra todo lo pendiente, pase lo que pase. */
    function barrer() {
      var alto = window.innerHeight || 0;
      piezas.forEach(function (el) {
        if (el.classList.contains('is-in')) return;
        var r = el.getBoundingClientRect();
        if (r.top < alto && r.bottom > 0) { mostrar(el); obs.unobserve(el); }
      });
    }
    barrer();
    window.addEventListener('load', barrer);
    window.addEventListener('resize', barrer, { passive: true });
    setTimeout(function () {
      piezas.forEach(function (el) { mostrar(el); obs.unobserve(el); });
    }, 4000);
  })();

  /* La barra fija aparece cuando el CTA del hero deja de verse: mientras está a la vista, la
     barra repetiría el mismo botón. Sin JavaScript no aparece nunca, y el CTA del hero y el del
     final siguen ahí: la acción nunca depende de esto. */
  (function () {
    var bar = document.querySelector('.lp-sticky');
    var ancla = document.querySelector('.lp-hero-ctas');
    var destino = document.getElementById('cotizar');
    if (!bar || !ancla || !('IntersectionObserver' in window)) return;

    /* La barra sobra en dos momentos: cuando el boton del hero esta a la vista (repetiria la
       misma accion) y cuando el formulario ya esta en pantalla, donde ademas le tapaba 70px
       justo mientras la persona lo llena. */
    var heroVisible = true;
    var formVisible = false;
    function pintar() { bar.classList.toggle('is-on', !heroVisible && !formVisible); }

    new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; pintar(); }).observe(ancla);
    if (destino) {
      new IntersectionObserver(function (e) { formVisible = e[0].isIntersecting; pintar(); }, { threshold: 0.12 }).observe(destino);
    }
  })();

  /* Envío real contra /api/contacto.php, la misma ruta que usan el formulario de contacto y el
     del pie. No se simula nada: si el servidor responde error, se dice. */
  (function () {
    var form = document.getElementById('lpForm');
    if (!(form instanceof HTMLFormElement)) return;
    var nombreEl = document.getElementById('lpNombre');
    var mailEl = document.getElementById('lpMail');
    var status = document.getElementById('lpStatus');
    var boton = form.querySelector('button[type="submit"]');
    var t0 = Date.now();

    function decir(txt, clase) {
      status.className = 'lp-status ' + clase;
      status.textContent = txt;
    }
    function track(ev, params) { if (typeof window.wfTrack === 'function') window.wfTrack(ev, params); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      nombreEl.removeAttribute('aria-invalid');
      mailEl.removeAttribute('aria-invalid');

      var nombre = nombreEl.value.trim();
      if (!nombre) {
        decir('Falta tu nombre para poder responderte.', 'is-err');
        nombreEl.setAttribute('aria-invalid', 'true');
        nombreEl.focus();
        return;
      }
      var mail = mailEl.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail)) {
        decir('Revisa el correo: ahí es donde te enviamos la cotización.', 'is-err');
        mailEl.setAttribute('aria-invalid', 'true');
        mailEl.focus();
        return;
      }

      /* Selección múltiple. La primera marcada define el asunto del correo (lista cerrada
         INTERESES de contacto.php); todas las marcadas se detallan en el cuerpo. */
      var marcadas = [].slice.call(form.querySelectorAll('input[name="ayuda"]:checked'));
      var elegidas = marcadas.map(function (c) {
        return ayudas.filter(function (a) { return a.v === c.value; })[0];
      }).filter(Boolean);
      var principal = elegidas[0] || { interes: 'salud', t: 'Sin especificar' };

      var detalle = elegidas.length
        ? elegidas.map(function (a) { return '· ' + a.t; }).join('\n')
        : '· No indicó una línea en particular.';
      var libre = document.getElementById('lpMsg').value.trim();
      var cuerpo = 'Solicitud de cotización desde la landing de centros de salud (Google Ads).\n\n'
        + 'Qué necesita:\n' + detalle
        + (libre ? '\n\nObjetivo:\n' + libre : '');

      var datos = new FormData();
      datos.set('form', 'contacto');
      datos.set('nombre', nombre);
      datos.set('email', mail);
      datos.set('tel', document.getElementById('lpTel').value.trim());
      datos.set('empresa', document.getElementById('lpCentro').value.trim());
      datos.set('interes', principal.interes);
      datos.set('msg', cuerpo);
      datos.set('website', document.getElementById('lpWebsite').value);
      datos.set('pagina', document.title + ' (' + location.pathname + ')');
      datos.set('e', String(Date.now() - t0));

      boton.disabled = true;
      decir('Enviando…', '');

      /* Se exige el {"ok":true} que devuelve contacto.php, no solo un 200: así un 200 que no sea
         del script (por ejemplo el archivo servido tal cual) nunca pasa por envío logrado. */
      fetch('/api/contacto.php', { method: 'POST', body: datos, credentials: 'same-origin' })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (j) {
          if (!j || j.ok !== true) throw new Error(j && j.error ? j.error : 'desconocido');
          track('generate_lead', { form_kind: 'landing-salud' });
          track('wf_cta_continue', { interes: principal.interes, surface: 'landing-salud' });
          decir('Listo. Recibimos tu solicitud y te respondemos en menos de 24 horas hábiles.', 'is-ok');
          form.reset();
        })
        .catch(function (err) {
          var motivo = String(err && err.message);
          if (motivo === 'limit') {
            decir('Recibimos varias solicitudes desde esta conexión. Espera un momento o escríbenos al +56 9 3197 1436.', 'is-err');
          } else if (motivo === 'fast') {
            decir('El envío salió demasiado rápido. Inténtalo otra vez, por favor.', 'is-err');
          } else if (motivo === 'email') {
            decir('El correo no fue aceptado. Revísalo e inténtalo de nuevo.', 'is-err');
            mailEl.setAttribute('aria-invalid', 'true');
            mailEl.focus();
          } else {
            decir('No pudimos enviar el formulario. Escríbenos a contacto@webfriends.cl o al +56 9 3197 1436 y lo resolvemos.', 'is-err');
          }
        })
        .then(function () { boton.disabled = false; });
    });
  })();
</script>
