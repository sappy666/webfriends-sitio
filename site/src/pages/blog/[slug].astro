---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authorOf, initials } from '../../data/authors';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CATEGORY_LABEL: Record<string, string> = {
  seo: 'SEO',
  ads: 'Google Ads',
  web: 'Desarrollo web',
  uxui: 'UX/UI',
  salud: 'Salud',
  marketing: 'Marketing',
};

const SERVICE_LABEL: Record<string, string> = {
  'page-seo': 'Ver servicio de SEO',
  'page-google-ads': 'Ver servicio de Google Ads',
  'page-sitios-web': 'Ver servicio de sitios web',
  'page-ux-ui': 'Ver servicio de UX/UI',
  'page-salud': 'Ver soluciones para salud',
};

function fmtDate(d: Date) {
  return d.toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).replace('.', '');
}

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => (a.data.category === post.data.category ? -1 : 1))
  .slice(0, 2);

const pages = await getCollection('pages');
const relatedServiceHref = `/${pages.find((p) => p.id === post.data.relatedService)!.data.urlSlug}`;

const author = authorOf(post.data);
// Datos estructurados del artículo (Google): autor, fecha y editor.
const site = Astro.site ?? new URL(Astro.url.origin);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site).toString(),
  author: author.id === 'equipo'
    ? { '@type': 'Organization', name: 'Webfriends', url: site.toString() }
    : {
        '@type': 'Person', name: author.name, jobTitle: author.role,
        url: new URL(author.href!, site).toString(),
        ...(author.linkedin ? { sameAs: [author.linkedin] } : {}),
        worksFor: { '@type': 'Organization', name: 'Webfriends' },
      },
  publisher: { '@type': 'Organization', name: 'Webfriends', url: site.toString() },
};
---
<BaseLayout title={post.data.metaTitle || `${post.data.title} — Blog Webfriends`} description={post.data.description}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/post.css" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Fragment>

  <div class="read-progress" id="readProgress" aria-hidden="true">
    <div class="read-progress-fill" id="readProgressFill"></div>
  </div>

  <section class="hero post-hero grid-bg">
    <div class="wrap" data-hero-seq>
      <a class="post-back" href="/blog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg> Volver al blog</a>
      <div class="post-hero-meta">
        <span class="post-tag">{CATEGORY_LABEL[post.data.category]}</span>
        <span class="post-date" style="color:var(--label-3);font-size:.8rem">Por {author.href ? <a class="post-author-name" href={author.href}>{author.name}</a> : <span class="post-author-name">{author.name}</span>} · {fmtDate(post.data.date)} · {post.data.readingTime}</span>
        <button class="post-listen" id="postListen" type="button" aria-label="Escuchar artículo" aria-pressed="false">
          <svg class="ico-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><use href="#i-mic"></use></svg>
          <span class="post-listen-txt">Escuchar</span>
        </button>
      </div>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.excerpt}</p>
      <div class="post-cover" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><use href={`#i-${post.data.coverIcon}`}></use></svg>
      </div>
    </div>
  </section>

  <section class="post-body-section" aria-labelledby="post-body-h">
    <div class="wrap post-layout">
      <h2 id="post-body-h" class="sr-only">Contenido del artículo</h2>
      <div class="post-body" data-reveal>
        <Content />
        <aside class="post-author" aria-label="Autor del artículo">
          <span class="post-author-avatar" aria-hidden="true">{initials(author.name)}</span>
          <span>
            <span class="post-author-by">Escrito por</span>
            <strong>{author.href ? <a href={author.href}>{author.name}</a> : author.name}</strong>
            <span class="post-author-role">{author.role} · Webfriends</span>
            {author.href && <a class="post-author-more" href={author.href}>Ver perfil y más artículos →</a>}
          </span>
        </aside>
        <div class="post-foot">
          <span class="post-tag">{CATEGORY_LABEL[post.data.category]}</span>
          <a class="btn btn-soft" href={relatedServiceHref}>{SERVICE_LABEL[post.data.relatedService]}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="post-related" aria-labelledby="related-h">
    <div class="wrap">
      <h2 id="related-h" data-reveal>Sigue leyendo</h2>
      <div class="post-related-grid" data-reveal-group>
        {related.map((r) => (
          <a class="post-related-card" data-reveal="scale" href={`/blog/${r.id}`}>
            <span class="post-cat">{CATEGORY_LABEL[r.data.category]}</span>
            <h3>{r.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>


  <Fragment slot="scripts">
    <script>
      // Barra lateral de progreso de lectura del artículo
      (function () {
        const body = document.querySelector('.post-body') as HTMLElement | null;
        const bar = document.getElementById('readProgress');
        const fill = document.getElementById('readProgressFill') as HTMLElement | null;
        if (!body || !bar || !fill) return;

        function update() {
          const rect = body!.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const scrolled = -rect.top;
          const p = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : 0;
          fill!.style.height = (p * 100).toFixed(0) + '%';
          bar!.classList.toggle('show', rect.top < window.innerHeight && rect.bottom > 0);
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();

      // Escuchar el artículo (texto a voz)
      (function () {
        const btn = document.getElementById('postListen') as HTMLButtonElement | null;
        const body = document.querySelector('.post-body');
        const h1 = document.querySelector('.post-hero h1');
        const synth = window.speechSynthesis;
        if (!btn || !body) return;

        if (!synth) {
          btn.disabled = true;
          btn.style.opacity = '.4';
          btn.style.cursor = 'not-allowed';
          btn.title = 'Tu navegador no soporta lectura en voz alta';
          return;
        }

        const icon = btn.querySelector('svg use');
        const label = btn.querySelector('.post-listen-txt');
        let speaking = false;

        function setState(on: boolean) {
          speaking = on;
          btn!.setAttribute('aria-pressed', String(on));
          if (icon) icon.setAttribute('href', on ? '#i-pause' : '#i-mic');
          if (label) label.textContent = on ? 'Pausar' : 'Escuchar';
        }

        btn.addEventListener('click', () => {
          if (speaking) {
            synth.cancel();
            setState(false);
            return;
          }
          const text = (h1 ? h1.textContent + '. ' : '') + (body.textContent || '');
          const utter = new SpeechSynthesisUtterance(text.replace(/\s+/g, ' ').trim());
          utter.lang = 'es-CL';
          utter.rate = 1;
          utter.addEventListener('end', () => setState(false));
          utter.addEventListener('error', () => setState(false));
          synth.cancel();
          synth.speak(utter);
          setState(true);
        });
      })();
    </script>
  </Fragment>
</BaseLayout>
