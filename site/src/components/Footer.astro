---
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');
const slug = (id: string) => `/${pages.find((p) => p.id === id)!.data.urlSlug}`;

const googleAdsHref = slug('page-google-ads');
const seoHref = slug('page-seo');
const sitiosWebHref = slug('page-sitios-web');
const uxUiHref = slug('page-ux-ui');
const saludHref = slug('page-salud');
const casosHref = slug('page-casos');
const nosotrosHref = slug('page-nosotros');
const contactoHref = slug('page-contacto');
const terminosHref = slug('page-terminos');
---
<footer class="ftr">
  <div class="wrap">
    <form class="ftr-lead" id="ftrLead" novalidate>
      <div>
        <h2 class="ftr-lead-h">Solicita una asesoría gratuita</h2>
        <p>Déjanos tu correo y te contactamos en menos de 24 horas hábiles. Sin costo ni compromiso.</p>
      </div>
      <div class="ftr-lead-field">
        <label class="sr-only" for="ftrEmail">Correo electrónico</label>
        <input id="ftrEmail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="tu@correo.cl" required>
        <button class="btn btn-accent" type="submit">Solicitar asesoría</button>
      </div>
      <p class="ftr-lead-status" id="ftrLeadStatus" role="status" aria-live="polite"></p>
    </form>

    <div class="ftr-grid">
      <div>
        <a class="logo" href="/" style="margin-bottom:16px"><span class="logo-mark" aria-hidden="true"><img class="logo-img-dark" src="/assets/img/webfriends-logo.png" alt="Webfriends" loading="lazy"><img class="logo-img-light" src="/assets/img/logotipo-negro-webfriends.png" alt="Webfriends" loading="lazy"></span></a>
        <p style="color:var(--label-2);font-size:var(--s--1);max-width:32ch">Agencia de marketing digital, desarrollo web y diseño UX/UI en Chile.</p>
        <div class="social">
          <a href="https://www.behance.net/webfriendscl" aria-label="Webfriends en Behance">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 6H2v12h7.2c2.6 0 4.3-1.3 4.3-3.5 0-1.6-.9-2.7-2.4-3 1.2-.4 1.9-1.4 1.9-2.7C13 6.9 11.5 6 9 6zm-.4 4.9H4.6V8.2h4c1 0 1.6.5 1.6 1.3s-.6 1.4-1.6 1.4zm.3 5H4.6v-3h4.3c1.2 0 1.9.6 1.9 1.5s-.7 1.5-1.9 1.5zM22 13.4c0-2.7-1.6-4.6-4.2-4.6s-4.3 1.9-4.3 4.7 1.7 4.7 4.4 4.7c2.1 0 3.6-1.1 4-2.8h-2.1c-.2.6-.9 1-1.8 1-1.2 0-2-.7-2.1-2H22v-1zm-6.1-.6c.2-1.2 1-1.8 2-1.8s1.8.7 1.9 1.8h-3.9zM15.5 6h5v1.5h-5z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/webfriends-chile" aria-label="Webfriends en LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-linkedin"></use></svg>
          </a>
          <a href="https://www.instagram.com/webfriendschile/" aria-label="Webfriends en Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><use href="#i-instagram"></use></svg>
          </a>
        </div>
      </div>

      <div>
        <h3>Servicios</h3>
        <ul>
          <li><a href={googleAdsHref}>Google Ads</a></li>
          <li><a href={seoHref}>Posicionamiento SEO</a></li>
          <li><a href={sitiosWebHref}>Sitios web</a></li>
          <li><a href={uxUiHref}>Diseño UX/UI</a></li>
          <li><a href={saludHref}>Soluciones para salud</a></li>
          <li><a href={slug('page-servicios')}>Todos los servicios</a></li>
        </ul>
      </div>

      <div>
        <h3>Empresa</h3>
        <ul>
          <li><a href={casosHref}>Casos de éxito</a></li>
          <li><a href={slug('page-precios')}>Precios</a></li>
          <li><a href={nosotrosHref}>Nosotros</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href={contactoHref}>Contacto</a></li>
        </ul>
      </div>

      <div>
        <h3>Oficinas</h3>
        <ul>
          <li><a href="https://maps.app.goo.gl/J38M7uX6a4EpdQa58">Etchevers 210, Viña del Mar</a></li>
          <li><a href="https://maps.app.goo.gl/UEC9HzqtVXwUKpLZ6">Av. Kennedy 7440, of. 701, Vitacura</a></li>
          <li><a href="mailto:contacto@webfriends.cl">contacto@webfriends.cl</a></li>
          <li><a href="tel:+56931971436">+56 9 3197 1436</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr-btm">
      <p>© 2026 Webfriends Chile · <a href={terminosHref} style="color:var(--label-2)">Términos</a> · <a href={`${terminosHref}#privacidad`} style="color:var(--label-2)">Privacidad</a></p>
      <p class="partner"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color:var(--amber)" aria-hidden="true"><path d="M12 2l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 16.3 6.2 19.8l1.6-6.6L2.6 8.8l6.8-.5L12 2z"/></svg> Google Partner certificado</p>
    </div>
  </div>
</footer>

<script>
// Asesoría gratuita desde el footer: valida el correo y abre WhatsApp indicando la página de origen.
const lead = document.getElementById('ftrLead') as HTMLFormElement | null;
if (lead) lead.addEventListener('submit', (e) => {
  e.preventDefault();
  const email = lead.email as HTMLInputElement;
  const status = document.getElementById('ftrLeadStatus')!;
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
    status.dataset.state = 'error';
    status.textContent = 'Revisa el correo: parece que le falta el @ o el dominio.';
    email.focus();
    return;
  }
  const w = window as any;
  w.wfWhatsApp(`Hola Webfriends, les escribo desde ${w.wfPage()} del sitio.\nCorreo: ${email.value.trim()}`);
  status.dataset.state = 'ok';
  status.textContent = 'Te abrimos WhatsApp con tu solicitud: solo presiona enviar.';
  lead.reset();
});
</script>
