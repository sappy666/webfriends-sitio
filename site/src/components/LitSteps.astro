<script>
// Etapas (.local-steps): se encienden de a una con el scroll (mismo efecto que el proceso del home).
// Se usa en todas las páginas de servicio.
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.querySelectorAll<HTMLElement>('.local-steps').forEach((grid) => {
  const steps = [...grid.querySelectorAll<HTMLElement>('.local-step')];
  const mm = gsap.matchMedia();
  const setup = () => {
    grid.classList.add('lit-scroll');
    steps.forEach((s) => s.removeAttribute('data-reveal'));
    return () => { grid.classList.remove('lit-scroll'); steps.forEach((s) => s.classList.remove('is-lit')); };
  };
  // Escritorio: etapas en fila, se encienden según el avance del scroll por la sección.
  mm.add('(min-width: 1001px) and (prefers-reduced-motion: no-preference)', () => {
    const undo = setup();
    const light = (p: number) => steps.forEach((s, k) => s.classList.toggle('is-lit', p >= k / steps.length + 0.02));
    gsap.fromTo(grid, { '--p': 0 }, {
      '--p': 1, ease: 'none',
      scrollTrigger: { trigger: grid, start: 'top 80%', end: 'top 25%', scrub: 0.6, onUpdate: (st) => light(st.progress), onRefresh: (st) => light(st.progress) },
    });
    return undo;
  });
  // Tablet y celular: etapas apiladas, cada una se enciende al llegar a media pantalla.
  mm.add('(max-width: 1000px) and (prefers-reduced-motion: no-preference)', () => {
    const undo = setup();
    steps.forEach((s) => ScrollTrigger.create({ trigger: s, start: 'top 62%', end: 'max', toggleClass: 'is-lit' }));
    return undo;
  });
});
</script>
