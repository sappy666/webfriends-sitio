---
// Ilustración lineal de un servicio (ver src/data/lineArt.ts). Hereda el color del texto.
import { lineArt } from '../data/lineArt';
import WebDesignIcon from './WebDesignIcon.astro';
import GoogleAdsIcon from './GoogleAdsIcon.astro';
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'uxui-1' ? <WebDesignIcon class={`line-art ${cls ?? ''}`} /> : name === 'ads' ? <GoogleAdsIcon class={`line-art ${cls ?? ''}`} /> : <svg class:list={['line-art', cls]} viewBox="0 0 160 120" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={lineArt[name] ?? ''} />}
