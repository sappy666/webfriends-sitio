---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArcScroll from '../ArcScroll.astro';

const page = (await getEntry('pages', 'page-nosotros'))!.data;
const sec = (id: string) => page.sections.find((s) => s.id === id)!;
const proceso = (await getEntry('procesoSeisEtapas', 'proceso-seis-etapas'))!.data.steps;
const principiosIcons = [
  '<use href="#i-chart-bars"></use>',
  '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0113 0"/><path d="M16 5.2a3.2 3.2 0 010 5.6M17 14.4a6.5 6.5 0 014.5 5.6"/>',
  '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
];
const certificacionesIcons = [
  '<use href="#i-trending"></use>',
  '<path d="M12 3l8 3v6c0 4.4-3.2 7.9-8 9-4.8-1.1-8-4.6-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  '<use href="#i-search"></use>',
  '<use href="#i-shield-check"></use>',
];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={page.ogImage?.image}
  ogImageAlt={page.ogImage?.alt}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/casos.css" />
  </Fragment>

  <section class="hero grid-bg" style="padding-block:clamp(44px,6vw,80px) clamp(40px,5vw,64px)">
    <div class="wrap" data-hero-seq>
      <p class="eyebrow">{page.heroEyebrow}</p>
      <h1 style="font-size:var(--s-4);max-width:17ch;margin:0 auto 22px;font-weight:800;letter-spacing:-.045em">{page.heroH1}</h1>
      <p class="lede" style="margin:0 auto;text-align:center;max-width:54ch">{page.heroLede}</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/contacto">Conversemos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
        <a class="btn btn-soft" href="/casos">Ver casos</a>
      </div>

    </div>
  </section>
  <section style="padding-block:0" aria-labelledby="stats-h">
    <div class="wrap">
      <h2 id="stats-h" class="sr-only">Cifras</h2>
      <div class="metrics-grid" data-reveal-group>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">2019</p>
          <p class="metric-l">Año de fundación</p>
          <p class="metric-src">Viña del Mar</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">100%</p>
          <p class="metric-l">Online</p>
          <p class="metric-src">Clientes en todo Chile</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">500+</p>
          <p class="metric-l">Clientes atendidos</p>
          <p class="metric-src">Chile y Latinoamérica</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">7</p>
          <p class="metric-l">Años como Google Partner</p>
          <p class="metric-src">Credencial verificable</p>
        </div>
      </div>
    </div>
  </section>
  <section id="principios" aria-labelledby="principios-h">
    <div class="wrap">
      <div class="hero-split-grid">
        <div>
          <p class="eyebrow" data-reveal>{sec('principios-h').eyebrow}</p>
          <h2 id="principios-h" class="h-sec" data-reveal>{sec('principios-h').heading}</h2>
          <p class="lede" data-reveal style="margin-top:18px">No son eslóganes: son reglas que usamos para decidir cuando hay que elegir entre dos caminos.</p>
        </div>
        <div class="hero-img" data-reveal="scale">
          <img src="/assets/img/nosotros.webp" alt="Cómo pensamos en Webfriends" width="1200" height="900" loading="lazy">
        </div>
      </div>
      <div class="cards cards-4" data-reveal-group style="margin-top:32px">
        {sec('principios-h').cards.map((card, i) => (
          <article class="card" data-reveal data-parallax="soft">
            <span class="card-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={principiosIcons[i]} /></span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="proceso" aria-labelledby="proceso-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('proceso-h').eyebrow}</p>
      <h2 id="proceso-h" class="h-sec" data-reveal>{sec('proceso-h').heading}</h2>
      <p class="lede" data-reveal style="margin-top:18px">El mismo proceso para campañas, sitios y productos digitales. Sabes qué recibes y cuándo.</p>
    </div>

    <!-- Recorrido en arco: las etapas avanzan sobre una curva a medida
         que se hace scroll. Sin JS o con movimiento reducido, se muestra
         como una lista ordenada normal y completamente legible. -->
    <div class="arc-stage" id="arcStage">
      <div class="arc-sticky">
        <div class="wrap arc-inner">

          <svg class="arc-curve" viewBox="0 0 200 800" fill="none" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 196 -60 C 40 140, 40 660, 196 860" stroke="var(--line-2)" stroke-width="1.5"/>
          </svg>

          <p class="arc-progress" aria-hidden="true">
            <span id="arcCurrent">01</span><span class="arc-sep">/</span><span>06</span>
          </p>

          <ol class="arc-list" id="arcList" data-reveal-group style="--rv-step:160ms;--rv-duration:1600ms;--rv-distance:10px">
            {proceso.map((step, i) => (
              <li class="arc-step" data-reveal="fade" style={`--i:${i}`}>
                <span class="arc-dot" aria-hidden="true"></span><span class="arc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="arc-body">
                  <span class="arc-title">{step.title}</span>
                  <span class="arc-desc">{step.description}</span>
                </span>
              </li>
            ))}
          </ol>

        </div>
      </div>
    </div>
  </section>
  <section id="certificaciones" aria-labelledby="certificaciones-h">
    <div class="wrap">
      <div class="hero-split-grid">
        <div>
          <p class="eyebrow" data-reveal>{sec('certificaciones-h').eyebrow}</p>
          <h2 id="certificaciones-h" class="h-sec" data-reveal>{sec('certificaciones-h').heading}</h2>
          <p class="lede" data-reveal style="margin-top:18px">Las credenciales no hacen el trabajo, pero sí garantizan acceso a soporte directo y formación actualizada.</p>
        </div>
        <div class="hero-img" data-reveal="scale">
          <img src="/assets/img/google-partners.webp" alt="Certificación Google Partner de Webfriends" width="1200" height="900" loading="lazy">
        </div>
      </div>
      <div class="cards cards-4" data-reveal-group style="margin-top:32px">
        {sec('certificaciones-h').cards.map((card, i) => (
          <article class="card" data-reveal data-parallax="soft">
            <span class="card-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={certificacionesIcons[i]} /></span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="oficinas" class="grad-warm" aria-labelledby="oficinas-h">
    <div class="wrap" style="text-align:center">
      <p class="eyebrow" data-reveal style="margin-inline:auto">{sec('oficinas-h').eyebrow}</p>
      <h2 id="oficinas-h" class="h-sec" data-reveal style="margin-inline:auto">{sec('oficinas-h').heading}</h2>
      <p class="lede" data-reveal style="margin:18px auto 0;text-align:center">No atendemos de forma presencial: coordinamos todo por videollamada, correo y WhatsApp, sin importar en qué región estés.</p>
    </div>
  </section>
  <section class="grid-bg" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="contact-card" data-reveal style="grid-template-columns:1fr;text-align:center;max-width:760px;margin-inline:auto">
        <div>
          <p class="eyebrow">{sec('cta-h').eyebrow}</p>
          <h2 id="cta-h" style="font-size:var(--s-3)">{sec('cta-h').heading}</h2>
          <p class="lede" style="margin:18px auto 0;font-size:var(--s-0);text-align:center">Agenda una reunión sin compromiso y te decimos con franqueza si podemos ayudarte o no.</p>
          <div class="hero-actions" style="justify-content:center;margin-top:30px">
            <a class="btn btn-accent" href="/contacto">Pedir asesoría gratuita
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
            </a>
            <a class="btn btn-soft" href="https://wa.me/56931971436">Escribir por WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>

<ArcScroll />
</BaseLayout>
