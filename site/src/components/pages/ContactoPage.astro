---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSchema from '../FaqSchema.astro';

const faqs = (await getCollection('faqs', ({ data }) => data.category === 'web')).sort(
  (a, b) => a.data.order - b.data.order
);

const page = (await getEntry('pages', 'page-contacto'))!.data;
const sec = (id: string) => page.sections.find((s) => s.id === id)!;
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={page.ogImage?.image}
  ogImageAlt={page.ogImage?.alt}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/service.css?v=2" />
  </Fragment>

  <section class="hero grid-bg" style="padding-block:clamp(44px,6vw,76px) clamp(20px,3vw,36px)">
    <div class="wrap" data-hero-seq>
      <p class="eyebrow">{page.heroEyebrow}</p>
      <h1 style="max-width:15ch;margin:0 auto 22px">{page.heroH1}</h1>
      <p class="lede" style="margin:0 auto;text-align:center;max-width:52ch">{page.heroLede}</p>
    </div>
  </section>

  <section class="grid-bg" style="padding-block:clamp(20px,3vw,40px) clamp(60px,8vw,110px)" aria-labelledby="form-h">
    <div class="wrap">
      <div class="contact-card" data-reveal>
        <div>
          <h2 id="form-h" style="font-size:var(--s-2)">¿Prefieres escribirnos directo?</h2>
          <p class="lede" style="margin-top:16px;font-size:var(--s-0)">Elige el canal que te acomode. Todos llegan al mismo equipo.</p>
          <div class="direct">
            <a href="https://wa.me/56931971436">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5a1 1 0 00-.7.3c-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6a9.3 9.3 0 003.6 3.2c1.7.7 1.7.5 2 .4.4 0 1.3-.5 1.5-1s.2-1 .1-1.1z"/></svg>
              Escribir por WhatsApp
              <span class="chev" aria-hidden="true">›</span>
            </a>
            <a href="tel:+56931971436">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
              (+56) 9 3197 1436
              <span class="chev" aria-hidden="true">›</span>
            </a>
            <a href="mailto:contacto@webfriends.cl">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
              contacto@webfriends.cl
              <span class="chev" aria-hidden="true">›</span>
            </a>
          </div>
          <p style="margin-top:26px;color:var(--label-3);font-size:var(--s--1)">
            Horario de atención: lunes a viernes, 9:00 a 18:30 h (hora de Chile).
          </p>
        </div>

        <form id="form" novalidate>
          <div class="field">
            <label for="nombre">Nombre <span class="req" aria-hidden="true">*</span></label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="email">Correo electrónico <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-hint">
            <span class="field-hint" id="email-hint">A esta dirección enviaremos la propuesta.</span>
          </div>
          <div class="field">
            <label for="msg">¿Qué necesitas?</label>
            <textarea id="msg" name="msg" placeholder="Una línea basta: nosotros te preguntamos el resto"></textarea>
          </div>

          <button type="button" class="toggle-extra" id="toggleExtra" aria-expanded="false" aria-controls="extra">
            + Añadir teléfono y empresa (opcional)
          </button>
          <div class="form-extra" id="extra" hidden>
            <div class="field">
              <label for="tel">Teléfono</label>
              <input id="tel" name="tel" type="tel" autocomplete="tel" inputmode="tel">
            </div>
            <div class="field">
              <label for="empresa">Empresa</label>
              <input id="empresa" name="empresa" type="text" autocomplete="organization">
            </div>
            <div class="field">
              <label for="interes">¿Qué te interesa?</label>
              <select id="interes" name="interes">
                <option value="general">Asesoría general</option>
                <option value="ads">Google Ads</option>
                <option value="seo">Posicionamiento SEO</option>
                <option value="web">Sitio o tienda web</option>
                <option value="salud">Plataforma para salud</option>
                <option value="uxui">Diseño UX/UI</option>
              </select>
            </div>
          </div>
          <button class="btn btn-accent btn-block" type="submit">
            Enviar solicitud
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </button>
          <p class="field-hint" style="margin-top:12px;text-align:center">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
          <p id="form-status" role="status" aria-live="polite" style="margin-top:12px;text-align:center;font-size:var(--s--1)"></p>
        </form>
      </div>
    </div>
  </section>
  <section id="oficinas" class="grad-warm" aria-labelledby="oficinas-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('oficinas-h').eyebrow}</p>
      <h2 id="oficinas-h" class="h-sec" data-reveal>{sec('oficinas-h').heading}</h2>
      <p class="lede" data-reveal style="margin-top:18px">Todo nuestro trabajo es online: coordinamos por videollamada, correo y WhatsApp con clientes de todo Chile, sin atención presencial.</p>
      <div class="grouped" data-reveal-group>
        {sec('oficinas-h').cards.map((card) => (
          <div class="row" data-reveal="fade">
            <div><h3>{card.title}</h3><p>{card.description}</p>
            <div class="chips">{card.chips.map((chip) => <span class="chip">{chip}</span>)}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section id="faq-contacto" aria-labelledby="faq-contacto-h">
    <div class="wrap">
      <div class="faq-card">
        <p class="eyebrow" data-reveal>{sec('faq-contacto-h').eyebrow}</p>
        <h2 id="faq-contacto-h" class="h-sec" data-reveal>{sec('faq-contacto-h').heading}</h2>
        <p class="lede" data-reveal>Reunimos las respuestas a las preguntas más comunes antes de escribirnos.</p>

        <div class="faq-grid" data-reveal-group>
          {faqs.map((faq) => (
            <details class="faq-item" data-reveal="fade">
              <summary>{faq.data.question}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><use href="#i-chevron-down"></use></svg></summary>
              <p>{faq.data.answer}</p>
            </details>
          ))}
        </div>
        <FaqSchema faqs={faqs.map((f) => f.data)} />
      </div>
    </div>
  </section>

</BaseLayout>
