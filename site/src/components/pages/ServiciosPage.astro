---
import LineArt from '../LineArt.astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = (await getEntry('pages', 'page-servicios'))!.data;
const sec = (id: string) => page.sections.find((s) => s.id === id)!;
const pages = await getCollection('pages');
const slug = (id: string) => `/${pages.find((p) => p.id === id)!.data.urlSlug}`;

// Mismo orden que las tarjetas de "servicios-h" en page-servicios.yaml.
const serviceMeta = [
  { pageId: 'page-google-ads', art: 'ads', link: 'Ver Google Ads' },
  { pageId: 'page-seo', art: 'seo-1', link: 'Ver SEO y GEO' },
  { pageId: 'page-sitios-web', art: 'web-1', link: 'Ver planes web' },
  { pageId: 'page-salud', art: 'medical-1', link: 'Ver soluciones para salud' },
  { pageId: 'page-ux-ui', art: 'uxui-1', link: 'Ver diseño UX/UI' },
];
const integralIcons = [
  '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0113 0"/><path d="M16 5.2a3.2 3.2 0 010 5.6M17 14.4a6.5 6.5 0 014.5 5.6"/>',
  '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={page.ogImage?.image}
  ogImageAlt={page.ogImage?.alt}
>
  <section class="hero grid-bg" style="padding-block:clamp(44px,6vw,80px) clamp(40px,5vw,64px)">
    <div class="wrap" data-hero-seq>
      <p class="eyebrow">{page.heroEyebrow}</p>
      <h1 style="max-width:17ch;margin:0 auto 22px">{page.heroH1}</h1>
      <p class="lede" style="margin:0 auto;text-align:center;max-width:54ch">{page.heroLede}</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/contacto">Pedir asesoría gratuita
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
        <a class="btn btn-soft" href="#lista">Ver servicios</a>
      </div>
    </div>
  </section>

  <section id="lista" aria-labelledby="servicios-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('servicios-h').eyebrow}</p>
      <h2 id="servicios-h" class="h-sec" data-reveal>{sec('servicios-h').heading}</h2>

      <div class="svc-list">
        {sec('servicios-h').cards.map((card, i) => (
          <article class="svc-row foil-card" data-reveal>
            <div class="svc-art">
              <LineArt name={serviceMeta[i].art} />
            </div>
            <div class="svc-txt">
              <p class="svc-num">{String(i + 1).padStart(2, '0')}</p>
              <h3>{card.title}</h3>
              <p class="svc-desc">{card.description}</p>
              {card.chips.length > 0 && <div class="chips">{card.chips.map((chip) => <span class="chip">{chip}</span>)}</div>}
              <div class="svc-actions">
                <a class="btn btn-soft" href={slug(serviceMeta[i].pageId)}>{serviceMeta[i].link}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
                </a>
                <a class="svc-quote" href="/contacto">Cotizar {card.title}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="grad-cool" aria-labelledby="integral-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('integral-h').eyebrow}</p>
      <h2 id="integral-h" class="h-sec" data-reveal>{sec('integral-h').heading}</h2>
      <div class="cards svc-integral" data-reveal-group>
        {sec('integral-h').cards.map((card, i) => (
          <article class="card" data-reveal>
            <span class="card-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={integralIcons[i]} /></span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
