---
import OtherServices from '../OtherServices.astro';
import DeviceShowcase from '../DeviceShowcase.astro';
import PricingFx from '../PricingFx.astro';
import LitSteps from '../LitSteps.astro';
import PlanCard from '../PlanCard.astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSchema from '../FaqSchema.astro';

const faqs = (await getCollection('faqs', ({ data }) => data.category === 'seo')).sort(
  (a, b) => a.data.order - b.data.order
);

const page = (await getEntry('pages', 'page-seo'))!.data;
const sec = (id: string) => page.sections.find((s) => s.id === id)!;
const seoPlans = (await getEntry('planSets', 'seo'))!.data.plans;
const capasIcons = [
  '<path d="M12 20a8 8 0 118-8"/><path d="M12 12l4-3"/>',
  '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  '<use href="#i-chart-bars"></use>',
  '<use href="#i-pin"></use>',
];
const localIcons = ['#i-home', '#i-file-text', '#i-star', '#i-pin'];
const geoCards = [
  { title: 'Contenido que responde', text: 'Páginas que contestan en forma directa las preguntas que tus clientes le hacen a la IA, con datos concretos y citables.', icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
  { title: 'Datos estructurados', text: 'Marcado schema para servicios, preguntas frecuentes y negocio local, para que los modelos entiendan quién eres y qué ofreces.', icon: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>' },
  { title: 'Autoridad y menciones', text: 'Presencia consistente en directorios, medios y reseñas: las IA confían en lo que ven repetido en fuentes distintas.', icon: '<path d="M12 2l3 6.5 7 .8-5.2 4.8 1.5 7L12 17.5 5.7 21l1.5-7L2 9.3l7-.8z"/>' },
  { title: 'Medición en IA', text: 'Revisamos cada mes en qué respuestas apareces, frente a qué competidores y qué tráfico llega desde asistentes de IA.', icon: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>' },
];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogImage={page.ogImage?.image}
  ogImageAlt={page.ogImage?.alt}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/service.css?v=4" />
  </Fragment>

  <section class="hero hero-split grid-bg" style="padding-block:clamp(44px,6vw,80px) clamp(40px,5vw,64px);text-align:left">
    <div class="wrap hero-split-grid" data-hero-seq>
      <div>
        <p class="eyebrow">{page.heroEyebrow}</p>
        <h1 style="max-width:15ch;margin:0 0 22px">{page.heroH1}</h1>
        <p class="lede" style="max-width:46ch">{page.heroLede}</p>
        <div class="hero-actions" style="justify-content:flex-start">
          <a class="btn btn-accent" href="/contacto">Pedir auditoría gratuita
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
          </a>
          <a class="btn btn-soft" href="#planes">Ver planes</a>
        </div>
      </div>

      <DeviceShowcase project="seo" name="Webfriends" altDesktop="Resultados de búsqueda de Google con Webfriends en el primer lugar para agencia de marketing digital" altMobile="Búsqueda en Google desde el celular con Webfriends en el primer resultado para agencia seo chile" cards={[{"value":"SEO técnico","label":"estructura e indexación"},{"value":"Google Mi Negocio","label":"ficha local optimizada"}]} />
    </div>
  </section>
  <section style="padding-block:0" aria-labelledby="stats-h">
    <div class="wrap">
      <h2 id="stats-h" class="sr-only">Cifras</h2>
      <div class="metrics-grid" data-reveal-group>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">20+</p>
          <p class="metric-l">Sitios optimizados</p>
          <p class="metric-src">Acumulado 2019–2026</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">3–6</p>
          <p class="metric-l">Meses para ver tracción</p>
          <p class="metric-src">Rango habitual en Chile</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">0</p>
          <p class="metric-l">Costo por clic</p>
          <p class="metric-src">El tráfico orgánico no se paga</p>
        </div>
        <div class="metric" data-reveal data-parallax="soft">
          <p class="metric-n">7</p>
          <p class="metric-l">Años como Google Partner</p>
          <p class="metric-src">Credencial verificable</p>
        </div>
      </div>
    </div>
  </section>
  <section id="capas" aria-labelledby="capas-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{sec('capas-h').eyebrow}</p>
      <h2 id="capas-h" class="h-sec" data-reveal>{sec('capas-h').heading}</h2>
      <p class="lede" data-reveal style="margin-top:18px">El SEO no es una sola cosa. Trabajamos las tres capas en paralelo, porque avanzar en una sola no mueve la aguja.</p>
      <div class="cards cards-4" data-reveal-group>
        {sec('capas-h').cards.map((card, i) => (
          <article class="card" data-reveal data-parallax="soft">
            <span class="card-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={capasIcons[i]} /></span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="local" class="dark-band" aria-labelledby="local-h">
    <div class="wrap">
      <div class="hero-split-grid tienda-intro">
        <div>
          <p class="eyebrow" data-reveal>{sec('local-h').eyebrow}</p>
          <h2 id="local-h" class="h-sec" data-reveal>{sec('local-h').heading}</h2>
          <p class="lede" data-reveal style="margin-top:18px">Si atiendes clientes de una zona concreta, el mapa de Google suele traer más contactos que la búsqueda tradicional.</p>

          <div class="local-cta" data-reveal>
            <a class="btn btn-accent" href="/contacto">
              Quiero mi ficha ahora
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </a>
            <p class="local-cta-note">Proceso simple y guiado de principio a fin.</p>
          </div>
        </div>

        <div class="hero-img" data-reveal="scale">
          <img src="/assets/img/seolocal.webp" alt="Ficha de Google Mi Negocio optimizada por Webfriends" width="1200" height="720" loading="lazy">
        </div>
      </div>

      <div class="local-steps" data-reveal-group>
        {sec('local-h').steps.map((step, i) => (
          <div class="local-step" data-reveal="fade">
            {i > 0 && <span class="local-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6"/></svg></span>}
            <div class="local-step-top">
              <span class="local-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="local-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href={localIcons[i]}></use></svg></span>
            </div>
            <h3><button type="button" class="step-toggle" aria-expanded="false" aria-controls={`step-body-${i}`}>{step.title}</button></h3>
            <div class="step-body" id={`step-body-${i}`}>
              <p>{step.description}</p>
              <div class="chips">{step.chips.map((chip) => <span class="chip">{chip}</span>)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- ═══════ GEO: aparecer en respuestas de IA ═══════ -->
  <section id="geo" aria-labelledby="geo-h">
    <div class="wrap">
      <div class="hero-split-grid geo-intro">
        <div>
          <p class="eyebrow" data-reveal>GEO · Posicionamiento en IA</p>
          <h2 id="geo-h" class="h-sec" data-reveal>Que la IA te recomiende cuando te buscan</h2>
          <p class="lede" data-reveal style="margin-top:18px">Cada vez más personas le preguntan a ChatGPT, Gemini, Perplexity o a las respuestas con IA de Google antes de hacer clic en un resultado. El GEO (Generative Engine Optimization) trabaja para que tu negocio aparezca citado en esas respuestas.</p>
          <p data-reveal style="margin-top:14px;color:var(--label-2);max-width:54ch">No reemplaza al SEO: se construye sobre él. Una IA solo recomienda lo que puede encontrar, entender y verificar en la web.</p>
          <div class="hero-actions" data-reveal style="justify-content:flex-start;margin-top:28px">
            <a class="btn btn-accent" href="/contacto?servicio=geo">
              Cotizar servicio
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
            </a>
          </div>
        </div>

        <figure class="geo-phone" data-reveal="scale">
          <img src="/assets/img/proj/geo-chatgpt.webp" alt="ChatGPT en el celular recomendando a Webfriends como agencia de SEO en Chile" width="640" height="1280" loading="lazy" decoding="async">
        </figure>
      </div>

      <div class="cards cards-4" data-reveal-group style="margin-top:44px">
        {geoCards.map((card) => (
          <article class="card" data-reveal>
            <span class="card-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={card.icon} /></span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="planes" aria-labelledby="planes-h">
    <div class="wrap" style="text-align:center">
      <p class="eyebrow" data-reveal>{sec('planes-h').eyebrow}</p>
      <h2 id="planes-h" class="h-sec" data-reveal style="margin-inline:auto">{sec('planes-h').heading}</h2>
      <p class="lede" data-reveal style="margin:18px auto 0;text-align:center">El SetUp es un trabajo inicial de una vez. Los planes mensuales sostienen y hacen crecer el posicionamiento en el tiempo.</p>
    </div>
    <div class="wrap">
      <div class="pricing" data-reveal-group style="margin-top:44px">
          {seoPlans.map((plan) => (
            <PlanCard plan={plan} />
          ))}
      </div>
      <p data-reveal style="text-align:center;margin-top:36px;color:var(--label-2)">
        ¿Necesitas algo distinto? <a href="/contacto" style="color:var(--amber);font-weight:700;text-decoration:none">Cuéntanos tu caso</a>
      </p>
    </div>
  </section>
  <section id="faq-seo" aria-labelledby="faq-seo-h">
    <div class="wrap">
      <div class="faq-card">
        <p class="eyebrow" data-reveal>{sec('faq-seo-h').eyebrow}</p>
        <h2 id="faq-seo-h" class="h-sec" data-reveal>{sec('faq-seo-h').heading}</h2>
        <p class="lede" data-reveal>Reunimos las respuestas a las preguntas más comunes sobre nuestro trabajo de SEO.</p>

        <div class="faq-grid" data-reveal-group>
          {faqs.map((faq) => (
            <details class="faq-item" data-reveal="fade">
              <summary>{faq.data.question}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><use href="#i-chevron-down"></use></svg></summary>
              <p>{faq.data.answer}</p>
            </details>
          ))}
        </div>
        <FaqSchema faqs={faqs.map((f) => f.data)} />
      </div>
    </div>
  </section>
  <OtherServices current="seo" />
  <section class="grid-bg" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="contact-card" data-reveal style="grid-template-columns:1fr;text-align:center;max-width:760px;margin-inline:auto">
        <div>
          <p class="eyebrow">{sec('cta-h').eyebrow}</p>
          <h2 id="cta-h" style="font-size:var(--s-3)">{sec('cta-h').heading}</h2>
          <p class="lede" style="margin:18px auto 0;font-size:var(--s-0);text-align:center">Revisamos tu situación actual en buscadores y te mostramos con datos concretos qué está frenando tu posicionamiento.</p>
          <div class="hero-actions" style="justify-content:center;margin-top:30px">
            <a class="btn btn-accent" href="/contacto">Pedir asesoría gratuita
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
            </a>
            <a class="btn btn-soft" href="https://wa.me/56931971436">Escribir por WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>

<LitSteps />
<PricingFx />
<style is:global>
  .geo-phone{margin:0;display:flex;justify-content:center}
  .geo-phone img{width:min(100%,330px);height:auto;filter:drop-shadow(0 40px 60px rgba(0,0,0,.55)) drop-shadow(0 0 40px rgba(255,176,32,.08))}
  @media (max-width:900px){.geo-phone img{width:min(78%,300px)}}
</style>
</BaseLayout>
