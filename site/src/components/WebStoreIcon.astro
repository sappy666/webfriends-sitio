---
// Ilustración animada de "Sitios y tiendas web": una vitrina con su botón de compra, y un
// cursor que lo aprieta. Era el único de los cinco servicios sin componente propio, así que
// salía del mapa estático de src/data/lineArt.ts y no se movía como sus hermanos.
// La animación vive en src/styles/minimal.css (.web-store-icon), igual que las demás.
// Mismo viewBox que WebDesignIcon, para que las dos ocupen lo mismo en la grilla de servicios.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['web-store-icon', cls]} viewBox="24 40 208 180" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <g class="ws-window">
    <rect x="36" y="52" width="180" height="144" rx="10" />
    <path d="M36 78h180" />
    <circle cx="50" cy="65" r="2" /><circle cx="61" cy="65" r="2" /><circle cx="72" cy="65" r="2" />

    <!-- La ficha del producto: imagen a la izquierda, nombre y precio a la derecha. -->
    <rect x="50" y="92" width="70" height="58" rx="2" />
    <circle cx="68" cy="108" r="5" />
    <path d="m50 150 24-21 14 12m-7-7 16-14 23 30" />
    <path d="M132 100h58M132 112h40" />
    <path d="M132 126h26" />

    <!-- El carrito, que es lo que la compra llena: mango, canasto y ruedas. -->
    <path d="M48 162h7l5 18h28l5-13H57" />
    <circle cx="64" cy="186" r="2.6" /><circle cx="84" cy="186" r="2.6" />
  </g>

  <!-- El botón de compra y lo que pasa al apretarlo. -->
  <g class="ws-press">
    <rect class="acc" x="132" y="140" width="68" height="22" rx="6" />
  </g>
  <path class="ws-done acc" d="m149 151 5 6 12-14" opacity="0" />
  <circle class="ws-ripple" cx="166" cy="151" r="9" opacity="0" />
  <path class="ws-cursor" d="m166 151 6 35 9-10 8 13 6-4-8-13 13-3z" />
</svg>
