---
import '../styles/global.css';
import '../styles/minimal.css';
import '../styles/light.css';
import Sprite from '../components/Sprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatButtons from '../components/FloatButtons.astro';
import SiteScripts from '../components/SiteScripts.astro';
import FaviconFx from '../components/FaviconFx.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
  ogImage?: string | null;
  ogImageAlt?: string;
  noindex?: boolean;
}

// Páginas sin imagen propia comparten una imagen de marca (1200×630) al compartirse en redes.
const DEFAULT_OG = { image: '/assets/img/og-default.jpg', alt: 'Webfriends, agencia de marketing digital en Chile' };
const { title, description, themeColor = '#000000', ogImage, noindex = false } = Astro.props;
const ogImageAlt = ogImage ? Astro.props.ogImageAlt : DEFAULT_OG.alt;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url.origin).toString();
const ogImageUrl = new URL(ogImage || DEFAULT_OG.image, Astro.site ?? Astro.url.origin).toString();
---
<!DOCTYPE html>
<html lang="es-CL">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}>
  <meta name="theme-color" content={themeColor}>
  <!-- Tema antes de pintar: la elección guardada del usuario o, si no eligió, la del sistema operativo. -->
  <script is:inline>(function(){var t=null;try{t=localStorage.getItem("wf-theme");}catch(e){}if(t!=="light"&&t!=="dark"){t=window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";}document.documentElement.setAttribute("data-theme",t);})();</script>
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {ogImageUrl && <meta property="og:image" content={ogImageUrl}>}
  {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt}>}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'}>
  {ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt}>}
  <!-- Fuente propia (ver @font-face en global.css): se precarga para que el titular se vea con ella desde el inicio -->
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high">
  <LocalBusinessSchema />
  <slot name="head" />
</head>
<body>
  <Sprite />
  <a class="skip" href="#contenido">Ir al contenido</a>
  <div class="readbar" aria-hidden="true"></div>

  <Header currentPath={currentPath} />

  <main id="contenido">
    <slot />
  </main>

  <Footer />

  <FloatButtons />
  <SiteScripts />
  <FaviconFx />
  <MobileNav />
  <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>
  <script>
    // Destello ámbar que sigue al cursor (solo escritorio con mouse, sin "reducir movimiento").
    // Se mueve con un leve retardo (interpolación) para sentirse fluido; se apaga al salir de la ventana.
    const glow = document.getElementById('cursorGlow');
    if (glow && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      let tx = innerWidth / 2, ty = innerHeight / 2, x = tx, y = ty, raf = 0;
      const tick = () => {
        x += (tx - x) * 0.14; y += (ty - y) * 0.14;
        glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
      };
      addEventListener('pointermove', (e) => {
        tx = e.clientX; ty = e.clientY; glow.classList.add('is-on');
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });
      document.documentElement.addEventListener('pointerleave', () => glow.classList.remove('is-on'));
    }
  </script>
  <script>
    // Tarjetas "lámina" (.foil-card, ver minimal.css): reflejo e inclinación siguen al cursor.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const tilt = matchMedia('(prefers-reduced-motion: no-preference)').matches;
      document.querySelectorAll<HTMLElement>('.foil-card').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--lx', `${e.clientX - r.left}px`);
          c.style.setProperty('--ly', `${e.clientY - r.top}px`);
          if (!tilt) return;
          const px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
          c.style.setProperty('--ry', `${(px * 12).toFixed(2)}deg`);
          c.style.setProperty('--rx', `${(-py * 12).toFixed(2)}deg`);
          c.classList.add('is-tilting');
        }, { passive: true });
        c.addEventListener('pointerleave', () => {
          c.classList.remove('is-tilting');
          c.style.setProperty('--rx', '0deg'); c.style.setProperty('--ry', '0deg');
        });
      });
    }
  </script>
  <script>
    // Heroes internos: el halo de fondo sigue suavemente al cursor (--mx/--my, ver minimal.css).
    if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      document.querySelectorAll<HTMLElement>('.hero').forEach((h) => {
        h.addEventListener('pointermove', (e) => {
          const r = h.getBoundingClientRect();
          h.style.setProperty('--mx', `${((e.clientX - r.left) / r.width * 100).toFixed(1)}%`);
          h.style.setProperty('--my', `${((e.clientY - r.top) / r.height * 100).toFixed(1)}%`);
        }, { passive: true });
      });
    }
  </script>
  <slot name="scripts" />
</body>
</html>
